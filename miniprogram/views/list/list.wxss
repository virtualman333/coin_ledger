:host {
  display: block;
}

.head {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 16rpx 24rpx 8rpx;
  background: #f6f4ef;
}

.search-row {
  display: flex;
  align-items: center;
}

.search {
  display: flex;
  flex: 1;
  height: 68rpx;
  align-items: center;
  padding: 0 22rpx;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(60, 48, 26, 0.05);
  min-width: 0;
}

.search-icon {
  margin-right: 10rpx;
  color: #8a8378;
  font-size: 30rpx;
  line-height: 1;
}

.filter-toggle {
  display: flex;
  height: 68rpx;
  margin-left: 14rpx;
  padding: 0 24rpx;
  align-items: center;
  border: 1rpx solid #e6dfd0;
  border-radius: 34rpx;
  background: #ffffff;
  color: #6b6559;
  font-size: 25rpx;
  flex-shrink: 0;
}

.filter-toggle.on {
  border-color: #d8b978;
  background: #fdf7ea;
  color: #9a6b1f;
  font-weight: 600;
}

.filter-badge {
  margin-left: 8rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #9a6b1f;
  color: #fff;
  font-size: 21rpx;
  line-height: 28rpx;
}

.fpanel {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(60, 48, 26, 0.05);
}

.frow {
  display: flex;
  flex-wrap: wrap;
}

.search-fake {
  display: flex;
  flex: 1;
  height: 68rpx;
  align-items: center;
  min-width: 0;
}

.search-input {
  flex: 1;
  height: 68rpx;
  min-width: 0;
  font-size: 27rpx;
}

.search-ph {
  color: #8a8378;
}

.search-clear {
  position: relative;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f2efe7;
  color: #6b6559;
  font-size: 22rpx;
}

/* 视觉保持 40rpx，热区用伪元素扩到 88rpx（手按得准，也不破坏视觉比例） */
.search-clear::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  margin: -44rpx 0 0 -44rpx;
}

.tabs {
  margin-top: 16rpx;
  padding-right: 24rpx;
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  height: 60rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  align-items: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b6559;
  font-size: 24rpx;
}

.tab-on {
  background: #9a6b1f;
  color: #ffffff;
  font-weight: 500;
}

.tab-hover {
  opacity: 0.7;
}

.bar {
  display: flex;
  padding: 16rpx 4rpx 6rpx;
  align-items: center;
  justify-content: space-between;
}

.bar-text {
  color: #6b6559;
  font-size: 22rpx;
}

.bar-actions {
  display: flex;
  align-items: center;
}

.bar-btn {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b6559;
  font-size: 22rpx;
}

.bar-btn.on {
  background: #f4efe4;
  color: #9a6b1f;
  font-weight: 600;
}

.list {
  padding: 0 24rpx calc(196rpx + env(safe-area-inset-bottom));
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(60, 48, 26, 0.04);
}

.row-hover {
  background: #fbf8f1;
}

.row-main {
  display: flex;
  flex: 1;
  margin-left: 18rpx;
  flex-direction: column;
  min-width: 0;
}

.row-top {
  display: flex;
  align-items: center;
  min-width: 0;
}

.row-name {
  flex: 1;
  overflow: hidden;
  font-size: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-top .tag {
  margin-left: 10rpx;
  flex-shrink: 0;
}

.row-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #6b6559;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-right {
  display: flex;
  margin-left: 16rpx;
  align-items: flex-end;
  flex-direction: column;
  flex-shrink: 0;
}

.row-year {
  color: #6b6559;
  font-size: 21rpx;
}

.row-price {
  margin-top: 8rpx;
  color: #9a6b1f;
  font-size: 27rpx;
  font-weight: 600;
}

.row-price-k {
  color: #6b6559;
  font-size: 21rpx;
  font-weight: 400;
}

/* 年份 / 面额 / 材质 筛选条（可横滑） */
.filters{
  display:flex;align-items:center;white-space:nowrap;
  padding:0 24rpx 18rpx;
}
.fbtn{
  display:inline-flex;align-items:center;
  margin-right:14rpx;padding:10rpx 22rpx;border-radius:999rpx;
  font-size:24rpx;color:#6b6559;background:#f5f3ee;border:1rpx solid #ece7dc;
}
.fbtn-on{color:#8a6a1f;background:#faf3dd;border-color:#e2cf9a;font-weight:600}
.fbtn-clear{color:#b04a3a;background:#fdf1ef;border-color:#f0d6d1}

/* 第二行：发行量 · 套系 */
.row-sub {
  display: flex;
  margin-top: 6rpx;
  align-items: center;
  overflow: hidden;
  color: #6b6559;
  font-size: 20rpx;
  white-space: nowrap;
}

.row-mint {
  color: #9a6b1f;
  font-weight: 500;
}

.row-dot {
  margin: 0 8rpx;
  color: #8a8378;
}

/* 分类切换：普通纪念币 / 纪念钞 / 贵金属
   之前 .cat-tabs / .cat-tab 没有任何样式，三个 view 直接挤成一行纯文字。 */
.cat-tabs {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0 4rpx;
}

.cat-tab {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e6e0d4;
  background: #ffffff;
  color: #6b6559;
  font-size: 25rpx;
  line-height: 1.4;
  transition: background .15s, color .15s;
}

.cat-tab.on {
  background: #fbf1d8;
  border-color: #d9bd82;
  color: #9a6b1f;
  font-weight: 600;
}

/* ===== 贵金属全量库（金币云集 2823 条）卡片网格 ===== */
/* 本页根节点没有 .page，安全区得自己补，否则最后一行卡片会被小白条压住 */
.pm-full { padding: 8rpx 24rpx calc(196rpx + env(safe-area-inset-bottom)); }
.pm-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 6rpx 0 18rpx;
  font-size: 24rpx;
  color: #6b6559;
}
.pm-bar-t { flex: 1; min-width: 0; }
.pm-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.pm-card {
  width: calc((100% - 18rpx) / 2);
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #eae2d2;
  border-radius: 18rpx;
  overflow: hidden;
}
.pm-card-hover { opacity: .88; transform: scale(.98); }
/* 1:1 占位用 padding-top 撑，不依赖 aspect-ratio —— 旧安卓 XWeb 不支持，
   会让同一行卡片高度参差（实测差 42rpx） */
.pm-ph {
  width: 100%;
  height: 0;
  padding-top: 100%;
  position: relative;
}
.pm-ph::after {
  content: "";
  position: absolute;
  left: 16%; top: 16%; right: 16%; bottom: 16%;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.55);
  box-shadow: inset 0 0 0 10rpx rgba(255,255,255,.18);
}
.pm-ph text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 64rpx;
  font-weight: 800;
  color: rgba(255,255,255,.92);
  z-index: 1;
}
.pm-gold { background: linear-gradient(145deg, #d4a72c, #b8861b); }
.pm-silver { background: linear-gradient(145deg, #b9c0c8, #9099a3); }
.pm-platinum { background: linear-gradient(145deg, #8d95a0, #6b7480); }
.pm-other { background: linear-gradient(145deg, #c9a227, #a88418); }
.pm-card-b { padding: 14rpx 16rpx 18rpx; }
.pm-card-t {
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #2b2620;
  min-height: 72rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pm-card-m { margin-top: 8rpx; font-size: 21rpx; color: #6b6559; }
.pm-card-f { margin-top: 8rpx; font-size: 21rpx; color: #8a6420; }
.pm-card-c { margin-top: 6rpx; font-size: 21rpx; color: #6b6559; font-family: monospace; }
.pm-loading, .pm-empty, .pm-end { text-align: center; font-size: 23rpx; color: #6b6559; padding: 28rpx 0; }
.pm-more {
  text-align: center;
  font-size: 25rpx;
  color: #8a6420;
  font-weight: 600;
  padding: 22rpx 0;
  margin-top: 16rpx;
  border: 1rpx solid #d9bd82;
  border-radius: 14rpx;
  background: #fbf1d8;
}

/* 贵金属卡片：数据库存的本地缩略图 */
.pm-thumb{width:100%;height:300rpx;display:block;background:#f6f4ef}

/* ===== 视图模式：分段控件（iOS segmented 手感） ===== */
.view-switch {
  position: relative;
  display: flex;
  margin: 16rpx 0 6rpx;
  padding: 4rpx;
  border-radius: 12rpx;
  background: #ebe5d8;
}
.vs-btn {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 13rpx 0;
  border-radius: 9rpx;
  color: #6b6559;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  text-align: center;
  transition: color .18s ease;
}
.vs-btn.on {
  color: #7a5410;
  font-weight: 600;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(74, 55, 20, 0.10), 0 1rpx 2rpx rgba(74, 55, 20, 0.06);
}

/* ===== 按系列视图 ===== */
.series-view { padding: 12rpx 24rpx calc(196rpx + env(safe-area-inset-bottom)); }
.sv-intro { margin: 12rpx 4rpx 20rpx; }
.sv-intro-t {
  display: block;
  color: #2b2620;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.sv-intro-t::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 30rpx;
  margin-right: 14rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #d9b364, #b98f43);
  vertical-align: -4rpx;
}
.sv-intro.note .sv-intro-t::before { background: linear-gradient(180deg, #7ea3bf, #5b86a8); }
.sv-intro.pm .sv-intro-t::before { background: linear-gradient(180deg, #c9a35f, #8c6b3f); }
.sv-intro-s { display: block; margin-top: 8rpx; color: #6b6559; font-size: 22rpx; }

.sv-cards { display: flex; flex-wrap: wrap; justify-content: space-between; }
.sv-card {
  width: 48.6%;
  margin-bottom: 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(74, 55, 20, 0.07);
  transition: transform .16s ease, box-shadow .16s ease;
}
.sv-hover { transform: translateY(-2rpx) scale(.985); box-shadow: 0 10rpx 26rpx rgba(74, 55, 20, 0.12); }
.sv-media { position: relative; width: 100%; height: 210rpx; background: #faf7f0; }
.sv-img { display: block; width: 100%; height: 100%; background: #ffffff; }
.sv-ph {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #faf3e2, #f0e5cd);
}
.sv-ph text { color: #8a6420; font-size: 23rpx; font-weight: 600; text-align: center; line-height: 1.5; }
.sv-ph-pm { background: linear-gradient(135deg, #f6efdf, #e9dcc0); }
.sv-ph-pm text { color: #6f5329; letter-spacing: 2rpx; }
.sv-badge {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(43, 38, 32, 0.72);
  color: #fff;
  font-size: 21rpx;
  backdrop-filter: blur(4rpx);
}
.sv-body { padding: 18rpx 20rpx 20rpx; }
.sv-name {
  display: block;
  min-height: 70rpx;
  color: #2b2620;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.sv-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.sv-tag {
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
  background: #f6efe0;
  color: #6b5f45;
  font-size: 21rpx;
}
.sv-tag-mat { background: #fbf2dd; color: #9a6b1f; }
.sv-foot { display: flex; margin-top: 14rpx; align-items: center; justify-content: space-between; }
.sv-own { color: #9a6b1f; font-size: 20rpx; font-weight: 500; }
.sv-own-none { color: #6b6559; font-weight: 400; }
.sv-arrow { color: #8a8378; font-size: 30rpx; line-height: 1; }
.sv-bar { margin-top: 12rpx; height: 6rpx; border-radius: 999rpx; background: #f2efe7; overflow: hidden; }
.sv-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #b98f43, #d9b364); }
.sv-empty {
  margin-top: 20rpx;
  padding: 100rpx 20rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #6b6559;
  font-size: 24rpx;
  text-align: center;
}

/* 加载失败：可点的重试入口，与「没有匹配品种」区分开 */
.pm-empty.pm-error{color:#b4553f;font-size:25rpx;padding:32rpx 20rpx}
