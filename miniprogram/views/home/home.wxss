:host {
  display: block;
}

/* ============ 首页 ============ */
.home {
  /* 这一层是 .page 本体，简写 padding-bottom 会抹掉全局的安全区留白。
     196rpx = 悬浮 tabBar 的 108rpx 高度 + 底部间距 + 一点透气余量 */
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部品牌 ---------- */
.hero {
  position: relative;
  padding: 38rpx 34rpx 36rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #221a12 0%, #3c2e1c 58%, #5d4726 100%);
}

.hero-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-brand {
  display: flex;
  flex-direction: column;
}

.hero-mark {
  color: #f3e3c0;
  font-size: 54rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
}

.hero-sub {
  margin-top: 12rpx;
  color: rgba(243, 227, 192, 0.62);
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.hero-share {
  width: auto;
  height: 46rpx;
  margin: 22rpx 0 0;
  padding: 0 20rpx;
  align-self: flex-start;
  border: 1rpx solid rgba(243, 227, 192, 0.3);
  border-radius: 999rpx;
  background: transparent;
  color: #e8c877;
  font-size: 20rpx;
}

.hero-share::after {
  border: none;
}

/* hero 右侧实物图 */
.hero-img {
  position: absolute;
  right: -12rpx;
  bottom: 28rpx;
  width: 196rpx;
  height: 196rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(232, 200, 119, 0.35);
  background: #fff;
  transform: rotate(-6deg);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.28);
}

/* 装饰：方孔圆钱 */
.hero-coin {
  position: absolute;
  right: -46rpx;
  bottom: -74rpx;
  width: 240rpx;
  height: 240rpx;
  border: 3rpx solid rgba(232, 200, 119, 0.22);
  border-radius: 50%;
}

.hero-coin::before {
  position: absolute;
  top: 26rpx;
  left: 26rpx;
  right: 26rpx;
  bottom: 26rpx;
  border: 1rpx solid rgba(232, 200, 119, 0.14);
  border-radius: 50%;
  content: "";
}

.coin-hole {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 66rpx;
  height: 66rpx;
  border: 3rpx solid rgba(232, 200, 119, 0.22);
  transform: translate(-50%, -50%);
}

/* ---------- 账本卡 ---------- */
.ledger {
  position: relative;
  z-index: 2;
  margin: 20rpx 0 0;
  padding: 28rpx 30rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(60, 48, 26, 0.10);
}

.ledger-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.ledger-title {
  color: #2b2926;
  font-size: 26rpx;
  font-weight: 600;
}

.ledger-count {
  color: #6b6559;
  font-size: 22rpx;
}

.lc-num {
  margin-right: 2rpx;
  color: #9a6b1f;
  font-size: 34rpx;
  font-weight: 600;
}

.bar {
  height: 10rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: #f1ece0;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #b98f43, #e8c877);
}

.ledger-sub {
  margin-top: 12rpx;
  color: #6b6559;
  font-size: 21rpx;
}

.nums {
  display: flex;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3efe6;
}

.num {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.num + .num {
  border-left: 1rpx solid #f3efe6;
}

.num-k {
  color: #6b6559;
  font-size: 20rpx;
}

.num-v {
  margin-top: 8rpx;
  color: #2b2926;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.num-v.up {
  color: #b23a2e;
}

.num-v.down {
  color: #2f7a4f;
}

.ledger.guest {
  padding-bottom: 32rpx;
  text-align: center;
}

.guest-title {
  display: block;
  color: #2b2926;
  font-size: 28rpx;
  font-weight: 600;
}

.guest-sub {
  display: block;
  margin-top: 10rpx;
  color: #6b6559;
  font-size: 22rpx;
}

.guest-btn {
  margin-top: 26rpx;
}

/* ---------- 区块标题 ---------- */
.sec {
  display: flex;
  margin: 40rpx 6rpx 20rpx;
  align-items: baseline;
  justify-content: space-between;
}

.sec-title {
  color: #2b2926;
  font-size: 32rpx;
  font-weight: 600;
}

.sec-more {
  color: #9a6b1f;
  font-size: 22rpx;
}

/* ---------- 最新发行（横滑） ---------- */
/* 正好三张：flex 均分，不依赖百分比取整，右侧不会漏出第四张 */
.latest {
  width: 100%;
}

.latest-inner {
  display: flex;
  padding: 2rpx 0 10rpx;
}

.lcard {
  display: flex;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  padding: 14rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(60, 48, 26, 0.05);
  flex-direction: column;
  box-sizing: border-box;
}

.lcard:last-child {
  margin-right: 0;
}

/* 正方形画框：竖版钞与圆币都在同一尺寸的框里居中，避免大小不齐 */
.lcard-fig {
  position: relative;
  height: 195rpx;
  border-radius: 12rpx;
  background: #fbf9f4;
  overflow: hidden;
}

.lcard-img {
  width: 100%;
  height: 100%;
  display: block;
}

.lcard-year {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  padding: 1rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(36, 28, 20, 0.66);
  color: #f0d79a;
  font-size: 21rpx;
}

.lcard-name {
  margin-top: 12rpx;
  color: #2b2926;
  font-size: 21rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lcard-face {
  margin-top: 4rpx;
  color: #6b6559;
  font-size: 21rpx;
}

.lcard-sub {
  margin-top: 2rpx;
  color: #9a6b1f;
  font-size: 21rpx;
}

/* ---------- 今日金银价 ---------- */
.metal-card {
  margin: 0 10rpx;
  padding: 28rpx 30rpx 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #2b2419, #4a3a20);
  box-shadow: 0 10rpx 28rpx rgba(60, 48, 26, 0.16);
}

.metal-grid {
  display: flex;
}

.metal-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.metal-item + .metal-item {
  padding-left: 32rpx;
  border-left: 1rpx solid rgba(232, 200, 119, 0.2);
}

.metal-k {
  color: rgba(243, 227, 192, 0.66);
  font-size: 21rpx;
}

.metal-v {
  margin-top: 6rpx;
  color: #e8c877;
  font-size: 40rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.metal-u {
  color: rgba(243, 227, 192, 0.56);
  font-size: 21rpx;
}

.metal-foot {
  display: flex;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(232, 200, 119, 0.16);
  align-items: baseline;
  justify-content: space-between;
}

.metal-time {
  color: #e8c877;
  font-size: 20rpx;
}

.metal-tip {
  color: rgba(243, 227, 192, 0.5);
  font-size: 21rpx;
}

/* ---------- 藏友晒单 ---------- */
.feed-list {
  margin: 0 10rpx;
}

.feed-card {
  display: flex;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(60, 48, 26, 0.05);
  align-items: center;
}

.feed-pic {
  width: 108rpx;
  height: 108rpx;
  flex: 0 0 108rpx;
  border-radius: 12rpx;
  background: #f6efe0;
}

.feed-ph {
  display: flex;
  width: 108rpx;
  height: 108rpx;
  flex: 0 0 108rpx;
  border-radius: 12rpx;
  background: #f6efe0;
  align-items: center;
  justify-content: center;
}

.feed-ph text {
  color: #8a6420;
  font-size: 40rpx;
}

.feed-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.feed-title {
  display: flex;
  align-items: center;
}

.feed-name {
  color: #2b2926;
  font-size: 25rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-tag {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #faf3e2;
  color: #9a6b1f;
  font-size: 21rpx;
}

.feed-serial {
  display: block;
  margin-top: 6rpx;
  color: #9a6b1f;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.feed-meta {
  display: block;
  margin-top: 8rpx;
  color: #6b6559;
  font-size: 20rpx;
}

.feed-arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #8a8378;
  font-size: 34rpx;
}

/* ---------- 系列 ---------- */
.series-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.series-item {
  display: flex;
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  padding: 26rpx 26rpx 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(60, 48, 26, 0.05);
  flex-direction: column;
  box-sizing: border-box;
}

.series-name {
  color: #2b2926;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.series-count {
  margin-top: 8rpx;
  color: #6b6559;
  font-size: 20rpx;
}

.series-own {
  color: #9a6b1f;
  font-weight: 600;
}

.series-bar {
  height: 8rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: #f3efe6;
  overflow: hidden;
}

.series-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #c39c47, #e8c877);
}

/* ---------- 页脚 ---------- */
.foot-note {
  padding: 30rpx 0 10rpx;
  text-align: center;
}

.foot-warn-note {
  display: block;
  margin-bottom: 10rpx;
  color: #6b6559;
  font-size: 21rpx;
}


.foot-warn {
  display: block;
  margin-top: 8rpx;
  color: #b23a2e;
  font-size: 20rpx;
}

/* 品牌副题 */
.hero-title {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.hero-tag {
  position: relative;
  padding-left: 16rpx;
  /* 深色 hero 上必须用浅色：暖米色 0.72 alpha 在 #221a12 上约 7.4:1 */
  color: rgba(243, 227, 192, 0.72);
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.hero-tag::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 1rpx;
  height: 22rpx;
  margin-top: -11rpx;
  background: #ddd5c6;
}
