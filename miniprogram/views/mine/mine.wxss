:host {
  display: block;
}

/* 我的：一个暖色主视觉块承载全部数字，下面是极简两行。
   不用渐变、不叠阴影，靠留白、字重和一处品牌金建立层次。 */

.page {
  padding-top: 24rpx;
  /* 底部让位给悬浮 tabBar：20rpx 外边距 + 116rpx 高度 + 安全区。
     196rpx(98px) 在 iPhone 上还差几 px，滚到底时最后一行会被压住一点 */
  padding-bottom: calc(228rpx + env(safe-area-inset-bottom));
}

/* ---------- 身份 ---------- */
.me {
  display: flex;
  padding: 6rpx 0 26rpx;
  align-items: center;
  gap: 16rpx;
}

.me-id {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  gap: 20rpx;
}

.me-ava {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: #f6efe0;
  flex: 0 0 auto;
}

.me-ava-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a6420;
  font-size: 36rpx;
  font-weight: 500;
}

.me-txt {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.me-name {
  color: #2b2926;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.me-sub {
  color: #6b6559;
  font-size: 22rpx;
}

.me-edit {
  padding: 9rpx 22rpx;
  border: 1rpx solid #e6dfd0;
  border-radius: 999rpx;
  color: #8a6420;
  font-size: 22rpx;
  flex: 0 0 auto;
}

/* ---------- 主视觉 ---------- */
.hero {
  padding: 28rpx 28rpx 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 3rpx 16rpx rgba(74, 55, 20, 0.06);
}

.hero-k {
  display: block;
  color: #6b6559;
  font-size: 22rpx;
}

.hero-line {
  display: flex;
  margin-top: 10rpx;
  align-items: baseline;
  gap: 8rpx;
  flex-wrap: wrap;
}

.hero-cur {
  color: #2b2926;
  font-size: 30rpx;
  font-weight: 500;
}

.hero-v {
  color: #2b2926;
  font-size: 54rpx;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.hero-d {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 500;
}

/* 涨跌是语义色，不是装饰色 */
.hero-d.up { color: #9c5850; }
.hero-d.down { color: #3f7050; }

.hero-sub {
  display: block;
  margin-top: 12rpx;
  color: #6b6559;
  font-size: 21rpx;
}

/* 进度做成 20 段刻度，像集章册的格子 */
.hero-prog {
  display: flex;
  margin-top: 22rpx;
  align-items: center;
  gap: 16rpx;
}

.hp-segs {
  flex: 1;
  display: flex;
  gap: 3rpx;
  height: 14rpx;
}

.hp-seg {
  flex: 1;
  border-radius: 2rpx;
  background: #f2eee4;
}

.hp-seg.on {
  background: #b98f43;
}

.hp-t {
  color: #6b6559;
  font-size: 20rpx;
  flex: 0 0 auto;
}

/* 空状态 / 未登录 */
.hero-empty {
  padding: 44rpx 32rpx 40rpx;
}

.he-t {
  display: block;
  color: #2b2926;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
}

.he-s {
  display: block;
  margin-top: 10rpx;
  color: #6b6559;
  font-size: 23rpx;
}

.he-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #b98f43, #d9b364);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

.he-primary {
  width: 300rpx;
  height: 84rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #b98f43, #d9b364);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.he-primary::after {
  border: none;
}

/* ---------- 两行入口 ---------- */
.rows {
  margin-top: 20rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 3rpx 16rpx rgba(74, 55, 20, 0.06);
}

.row-thumbs {
  display: flex;
  flex: 0 0 auto;
  padding-right: 4rpx;
}

.rt-img {
  width: 54rpx;
  height: 54rpx;
  margin-left: -16rpx;
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
  background: #f6efe0;
}

.rt-img:first-child {
  margin-left: 0;
}

/* ---------- 页脚 ---------- */
.foot {
  margin-top: 22rpx;
  color: #8a8378;
  font-size: 20rpx;
  text-align: center;
}

/* ================= 收藏构成 ================= */
.mkinds {
  display: flex;
  gap: 12rpx;
  margin: 18rpx 0 4rpx;
}

.mk {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 22rpx 8rpx;
  border-radius: 16rpx;
  border: 1rpx solid #ece7dc;
  background: #ffffff;
}

/* 没有这类的收藏时整格压暗：0 也是信息，但别和数据抢注意力 */
.mk.is-zero {
  opacity: 0.5;
}

.mk-n {
  color: #8a8378;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
}

.mk-n.on {
  color: #8a6420;
}

.mk-t {
  color: #6b6559;
  font-size: 20rpx;
  line-height: 1.3;
  text-align: center;
}

/* ================= 快捷动作 ================= */
.quick {
  display: flex;
  gap: 12rpx;
  margin: 18rpx 0 4rpx;
  padding: 22rpx 12rpx;
  border-radius: 18rpx;
  border: 1rpx solid #ece7dc;
  background: #ffffff;
}

.qk {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.qk-ico {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #faf8f3;
  color: #8a6420;
  font-size: 30rpx;
  line-height: 1;
}

.qk-t {
  color: #6b6559;
  font-size: 21rpx;
  line-height: 1.3;
}

/* ================= 最近添加 ================= */
.recent {
  margin: 18rpx 0 4rpx;
}

.sec-h {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.sec-t {
  color: #2b2926;
  font-size: 26rpx;
  font-weight: 600;
}

.sec-more {
  color: #8a6420;
  font-size: 22rpx;
}

.rc-scroll {
  white-space: nowrap;
}

.rc {
  display: inline-flex;
  flex-direction: column;
  width: 188rpx;
  margin-right: 14rpx;
  vertical-align: top;
}

.rc:last-child {
  margin-right: 0;
}

.rc-img,
.rc-ph {
  width: 188rpx;
  height: 172rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #ece7dc;
}

.rc-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8378;
  font-size: 40rpx;
  font-weight: 700;
}

.rc-n {
  display: -webkit-box;
  margin-top: 10rpx;
  color: #2b2926;
  font-size: 21rpx;
  line-height: 1.35;
  white-space: normal;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.rc-q {
  margin-top: 6rpx;
  color: #8a8378;
  font-size: 20rpx;
}

/* 维护状态说明 */
.mt-note{
  margin:16rpx 0 4rpx;padding:18rpx 22rpx;border-radius:16rpx;
  background:#fdf7ea;border:1rpx solid #efe0c4
}
.mt-note-t{display:block;font-size:24rpx;font-weight:600;color:#8a6420}
.mt-note-d{display:block;margin-top:6rpx;font-size:21rpx;line-height:1.6;color:#8a7a5e}
