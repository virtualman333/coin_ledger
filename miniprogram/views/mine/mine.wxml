<view class="page">
  <block wx:if="{{loggedIn}}">
    <view class="me">
      <view class="me-id" hover-class="tap-hover" hover-stay-time="80" bindtap="goProfile" aria-role="button" aria-label="个人资料">
        <image class="me-ava" src="{{userAvatar}}" mode="aspectFill" wx:if="{{userAvatar}}"></image>
        <view class="me-ava me-ava-ph" wx:else>{{displayName ? displayName[0] : '藏'}}</view>
        <view class="me-txt">
          <text class="me-name">{{displayName}}</text>
          <text class="me-sub">{{maintenance ? '账本功能调整中' : (stats.kinds ? (stats.kinds + ' 个品种 · ' + stats.rolls + ' 套') : '还没有记录')}}</text>
        </view>
      </view>
      <view class="me-edit" hover-class="tap-hover" bindtap="goProfile">编辑</view>
    </view>

    <!-- 维护状态下账本整套收起，只留说明 -->
    <view class="mt-note" wx:if="{{maintenance}}">
      <text class="mt-note-t">账本功能调整中</text>
      <text class="mt-note-d">图鉴、发行计划与拍照数币照常使用</text>
    </view>

    <!-- 唯一的主视觉块：市值、投入、面值、进度收在一起 -->
    <view class="hero" wx:if="{{!maintenance && stats.kinds}}">
      <text class="hero-k">参考市值</text>
      <view class="hero-line">
        <text class="hero-cur">¥</text>
        <text class="hero-v">{{stats.marketText}}</text>
        <text class="hero-d {{stats.up ? 'up' : 'down'}}">{{stats.pnlText}} · {{stats.pnlPct}}%</text>
      </view>
      <text class="hero-sub">已投入 ¥{{stats.costText}} · 面值 ¥{{stats.faceText}}</text>
      <view class="hero-prog">
        <view class="hp-segs">
          <view class="hp-seg {{item ? 'on' : ''}}" wx:for="{{segs}}" wx:key="index"></view>
        </view>
        <text class="hp-t">{{stats.kinds}} / {{totalCoins}}</text>
      </view>
    </view>

    <view class="hero hero-empty" wx:elif="{{!maintenance}}">
      <text class="he-t">还没有收藏</text>
      <view class="he-btn" hover-class="tap-hover" bindtap="goList">去挑第一枚</view>
    </view>

    <!-- 收藏构成：一眼看出普通纪念币/钞/贵金属各收了多少，点了直接跳对应分类 -->
    <view class="mkinds" wx:if="{{!maintenance && stats.kinds}}">
      <view
        class="mk {{item.n ? '' : 'is-zero'}}"
        wx:for="{{dist}}"
        wx:key="key"
        data-cat="{{item.key}}"
        hover-class="tap-hover"
        hover-stay-time="80"
        bindtap="goCat"
        aria-role="button"
        aria-label="{{item.name}} {{item.n}} 个"
      >
        <text class="mk-n {{item.n ? 'on' : ''}}">{{item.n}}</text>
        <text class="mk-t">{{item.name}}</text>
      </view>
    </view>

    <view class="rows">
      <view class="cell" wx:if="{{!maintenance}}" hover-class="row-hover" hover-stay-time="80" bindtap="goHoldings" aria-role="button" aria-label="我的收藏">
        <text class="cell-k">我的收藏</text>
        <view class="row-thumbs" wx:if="{{thumbs.length}}">
          <image wx:for="{{thumbs}}" wx:key="*this" class="rt-img" src="{{item}}" mode="aspectFill"></image>
        </view>
        <text class="cell-v">{{stats.kinds}} 个品种</text>
        <text class="cell-a">›</text>
      </view>
      <view class="cell" hover-class="row-hover" hover-stay-time="80" bindtap="goMoreTools" aria-role="button" aria-label="更多功能">
        <text class="cell-k">更多功能</text>
        <text class="cell-v">备份 · 关于 · 条款</text>
        <text class="cell-a">›</text>
      </view>
    </view>

    <!-- 快捷动作：都是要再点两三层才到的入口，直接放出来 -->
    <view class="quick">
      <view
        class="qk"
        wx:for="{{quick}}"
        wx:key="key"
        data-key="{{item.key}}"
        hover-class="tap-hover"
        hover-stay-time="80"
        bindtap="onQuick"
        aria-role="button"
        aria-label="{{item.name}}"
      >
        <view class="qk-ico">{{item.icon}}</view>
        <text class="qk-t">{{item.name}}</text>
      </view>
    </view>

    <!-- 最近添加：数组尾部就是最后加入的，点直接进详情 -->
    <view class="recent" wx:if="{{!maintenance && recent.length}}">
      <view class="sec-h">
        <text class="sec-t">最近添加</text>
        <text class="sec-more" hover-class="tap-hover" bindtap="goHoldings">全部 ›</text>
      </view>
      <scroll-view class="rc-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view
          class="rc"
          wx:for="{{recent}}"
          wx:key="index"
          data-idx="{{index}}"
          hover-class="tap-hover"
          bindtap="goRecent"
        >
          <image class="rc-img" src="{{item.img}}" mode="aspectFit" lazy-load wx:if="{{item.img}}"></image>
          <view class="rc-ph" wx:else>{{item.initial}}</view>
          <text class="rc-n">{{item.name}}</text>
          <text class="rc-q">{{item.qtyText}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="foot" wx:if="{{syncTip}}">{{syncTip}}</view>
    <view class="foot">价格为参考估算，不构成投资建议</view>
  </block>

  <block wx:else>
    <view class="mt-note" wx:if="{{maintenance}}">
      <text class="mt-note-t">账本功能调整中</text>
      <text class="mt-note-d">图鉴、发行计划与拍照数币照常使用</text>
    </view>
    <view class="hero hero-empty guest" wx:if="{{!maintenance}}">
      <text class="he-t">登录后才有账本</text>
      <text class="he-s">收藏存在云端，换设备也能接着记</text>
      <button class="he-primary" bindtap="goAccount">登录 / 注册</button>
    </view>

    <view class="rows">
      <view class="cell" hover-class="row-hover" hover-stay-time="80" bindtap="goMoreTools" aria-role="button" aria-label="更多功能">
        <text class="cell-k">更多功能</text>
        <text class="cell-a">›</text>
      </view>
    </view>
  </block>
</view>
