.doc {
  padding: 8rpx 4rpx 40rpx;
}

.doc-h1 {
  display: block;
  color: #2b2926;
  font-size: 40rpx;
  font-weight: 600;
}

.doc-meta {
  display: block;
  margin-top: 12rpx;
  color: #6b6559;
  font-size: 20rpx;
}

.doc-h2 {
  display: block;
  margin: 36rpx 0 10rpx;
  color: #2b2926;
  font-size: 27rpx;
  font-weight: 600;
}

.doc-p {
  display: block;
  margin-top: 10rpx;
  color: #4a4438;
  font-size: 25rpx;
  line-height: 1.85;
}

.doc-note {
  display: block;
  margin-top: 40rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #ece7db;
  color: #6b6559;
  font-size: 22rpx;
  line-height: 1.8;
}
