<view class="page">
  <view class="head">
    <text class="h1">更多功能</text>
    <text class="h-sub">藏币录还在长。你想要的，可以直接说。</text>
  </view>

  <!-- 已经有的 -->
  <view class="card sec">
    <text class="sec-title">现在能用的</text>
    <view class="feat" wx:for="{{features}}" wx:key="k">
      <view class="feat-ico">{{item.ico}}</view>
      <view class="feat-main">
        <text class="feat-name">{{item.name}}</text>
        <text class="feat-desc">{{item.desc}}</text>
      </view>
      <text class="feat-tag {{item.on ? 'on' : ''}}">{{item.on ? '已上线' : '计划中'}}</text>
    </view>
  </view>

  <!-- 提需求 -->
  <view class="card sec">
    <text class="sec-title">想要什么功能？</text>
    <text class="sec-sub">比如「按年份筛选」「导出 Excel」「整卷成本自动拆分」——写清楚你想解决什么问题，比写功能名字更有用。</text>

    <view class="ta-wrap">
      <textarea
        class="ta"
        value="{{text}}"
        maxlength="400"
        placeholder="我想要……"
        placeholder-class="ph"
        bindinput="onInput"
        auto-height
      ></textarea>
      <text class="ta-count">{{text.length}}/400</text>
    </view>

    <button class="btn-primary submit" bindtap="submit" loading="{{busy}}" disabled="{{!text || leftToday <= 0}}">
      {{leftToday <= 0 ? '今天提交满了，明天再来' : '提交建议'}}
    </button>

    <text class="tip">提交后会进入我们的需求池，不承诺一定实现；同一问题提的人多，会优先做。</text>
  </view>

  <view class="foot">
    <text>已经提过 {{sentCount}} 条，今天还能提 {{leftToday}} 条</text>
  </view>
</view>
