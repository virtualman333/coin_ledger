@import "../admin/admin-common.wxss";

/* 访客页本地补充：通用样式在 admin-common.wxss，这里只放本页新增的元素 */

/* 混合来源（同一 IP 既开过网页又用过小程序）不能跟「小程序」共用绿色 */
.vsrc.mix { background: #f3efe6; color: #8a6420; }

/* IP 分组有昵称时，账号名单独一行，便于认账号 */
.vr-acc { display: block; margin-top: 4rpx; color: #8a8378; font-size: 20rpx; }

/* 会话列表被服务端截断时的说明 */
.vs-cap {
  display: block;
  margin: 4rpx 0 10rpx;
  color: #8a8378;
  font-size: 20rpx;
}

/* 分页：只渲染前 N 条，其余点开再展开 */
.vs-more {
  margin: 16rpx 0 10rpx;
  padding: 18rpx 0;
  text-align: center;
  border: 1rpx solid #e6dfd0;
  border-radius: 12rpx;
  background: #ffffff;
  color: #6b6559;
  font-size: 23rpx;
}

/* 明细弹层的汇总条 */
.vdd-sum {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 20rpx;
  padding: 0 0 14rpx;
  color: #6b6559;
  font-size: 21rpx;
}
/* 汇总数字用 <text> 而非 <b>：WXML 不渲染 b 标签，数字会整块消失 */
.vdd-num { color: #8a6420; font-size: 25rpx; font-weight: 600; }
.vdd-sum-ip { margin-left: auto; color: #8a8378; font-family: monospace; }

/* 访客头像：有图显示图，没有就用首字圆形占位，和后台其它列表一致 */
.vr-ava {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #f2efe7;
}
.vr-ava-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b6559;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
}

/* 行尾箭头：明确「整行可点，进去看明细」 */
.vr-go {
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: #bdb7ab;
  font-size: 34rpx;
  line-height: 1;
}

.vdd-empty {
  padding: 44rpx 0;
  text-align: center;
  color: #8a8378;
  font-size: 22rpx;
}
