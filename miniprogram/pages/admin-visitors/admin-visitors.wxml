<page-meta page-style="{{vsDetail ? 'overflow:hidden' : ''}}"></page-meta>

<view class="page">

    <view class="vs-bar">
      <text
        class="vchip {{vsClient === item.v ? 'on' : ''}}"
        wx:for="{{vsClients}}"
        wx:key="v"
        data-v="{{item.v}}"
        bindtap="setVsClient"
      >{{item.t}}</text>
    </view>

    <view class="vs-bar">
      <text
        class="vchip {{vsRange === item.v ? 'on' : ''}}"
        wx:for="{{vsRanges}}"
        wx:key="v"
        data-v="{{item.v}}"
        bindtap="setVsRange"
      >{{item.t}}</text>
    </view>

    <view class="vs-cards" wx:if="{{visitors}}">
      <view class="vsc"><text class="vsn">{{visitors.rangePv}}</text><text class="vsk">访问次数</text></view>
      <view class="vsc"><text class="vsn">{{visitors.rangeUv}}</text><text class="vsk">独立 IP</text></view>
      <view class="vsc"><text class="vsn">{{visitors.todayPv}}</text><text class="vsk">今日 PV</text></view>
      <view class="vsc"><text class="vsn">{{visitors.byClient.mp.pv}}</text><text class="vsk">小程序 PV</text></view>
    </view>
    <text class="vs-note" wx:if="{{visitors}}">
      区间 {{visitors.range.from}} 至 {{visitors.range.to}} · 累计 {{visitors.allPv}} 次访问
    </text>

    <view class="vs-bar">
      <text
        class="vchip {{vsView === item.v ? 'on' : ''}}"
        wx:for="{{vsViews}}"
        wx:key="v"
        data-v="{{item.v}}"
        bindtap="setVsView"
      >{{item.t}}</text>
      <text class="vs-hint">点一行看明细</text>
    </view>

    <view class="loading" wx:if="{{vsLoading}}">加载中…</view>
    <view class="vs-err" wx:elif="{{vsError}}" bindtap="loadVisitors">{{vsError}}，点击重试</view>
    <view class="card list" wx:elif="{{visRows.length}}">
      <view
        class="vr"
        wx:for="{{visRows}}"
        wx:key="key"
        data-kind="{{item.kind}}"
        data-key="{{item.key}}"
        bindtap="openVsDetail"
        hover-class="tap-hover"
      >
        <view class="vr-main">
          <view class="vr-title">
            <text>{{item.main}}</text>
            <text class="vsrc {{item.srcCls}}">{{item.src}}</text>
            <text class="vdev">{{item.device}}</text>
          </view>
          <text class="vr-meta">{{item.meta}}</text>
        </view>
        <view class="vr-right">
          <text class="vr-time">{{item.sub}}</text>
          <text class="vr-ip">{{item.ip}}</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>还没有访客记录</view>
</view>


  <!-- 访客明细弹层 -->
  <!-- 不要再加 catchtouchmove：它会连带取消 .vdd-list 这个 scroll-view 的内部滚动，
       页面滚动改由上面的 page-meta 关掉 -->
  <view class="vdd-mask" wx:if="{{vsDetail}}">
    <view class="vdd-sheet" catchtap="noop">
      <view class="vdd-head">
        <text class="vdd-title">{{vsDetail.title}}</text>
        <text class="vdd-x" bindtap="closeVsDetail">✕</text>
      </view>
      <text class="vdd-sub">共 {{vsDetail.total}} 条访问明细</text>
      <scroll-view scroll-y class="vdd-list">
        <view class="vdd-row" wx:for="{{vsDetail.rows}}" wx:key="index">
          <text class="vdd-time">{{item.at}}</text>
          <text class="vdd-tab">{{item.tab}}</text>
          <text class="vdd-src {{item.srcCls}}">{{item.src}}</text>
          <text class="vdd-user">{{item.user}}</text>
        </view>
      </scroll-view>
      <view class="vdd-foot" bindtap="closeVsDetail">关闭</view>
    </view>
  </view>
