<page-meta page-style="{{vsDetail ? 'overflow:hidden' : ''}}"></page-meta>

<view class="page">

    <view class="vs-bar">
      <text
        class="vchip {{vsClient === item.v ? 'on' : ''}}"
        wx:for="{{vsClients}}"
        wx:key="v"
        data-v="{{item.v}}"
        bindtap="setVsClient"
      >{{item.t}}</text>
    </view>

    <view class="vs-bar">
      <text
        class="vchip {{vsRange === item.v ? 'on' : ''}}"
        wx:for="{{vsRanges}}"
        wx:key="v"
        data-v="{{item.v}}"
        bindtap="setVsRange"
      >{{item.t}}</text>
    </view>

    <view class="vs-cards" wx:if="{{vsCards.length}}">
      <view class="vsc" wx:for="{{vsCards}}" wx:key="k">
        <text class="vsn">{{item.n}}</text>
        <text class="vsk">{{item.k}}</text>
      </view>
    </view>
    <text class="vs-note" wx:if="{{vsNote}}">{{vsNote}}</text>

    <view class="vs-bar">
      <text
        class="vchip {{vsView === item.v ? 'on' : ''}}"
        wx:for="{{vsViews}}"
        wx:key="v"
        data-v="{{item.v}}"
        bindtap="setVsView"
      >{{item.t}}</text>
      <text class="vs-hint">共 {{vsTotal}} 条 · 点一行看明细</text>
    </view>

    <view class="loading" wx:if="{{vsLoading && !vsCards.length}}">加载中…</view>
    <view class="vs-err" wx:elif="{{vsError}}" bindtap="loadVisitors">{{vsError}}，点击重试</view>
    <block wx:elif="{{vsRows.length}}">
      <text class="vs-cap" wx:if="{{vsSessionsCapped}}">会话较多，这里只列最近 40 个（含未展开的历史会话）</text>
      <view class="card list">
        <view
          class="vr"
          wx:for="{{vsRows}}"
          wx:key="key"
          data-kind="{{item.kind}}"
          data-key="{{item.key}}"
          data-who="{{item.main}}"
          bindtap="openVsDetail"
          hover-class="tap-hover"
        >
          <image class="vr-ava" wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="vr-ava vr-ava-ph" wx:else>{{item.initial}}</view>
          <view class="vr-main">
            <view class="vr-title">
              <text>{{item.main}}</text>
              <text class="vsrc {{item.srcCls}}">{{item.src}}</text>
              <text class="vdev" wx:if="{{item.device}}">{{item.device}}</text>
            </view>
            <text class="vr-acc" wx:if="{{item.acc}}">账号 {{item.acc}}</text>
            <text class="vr-meta">{{item.meta}}</text>
          </view>
          <view class="vr-right">
            <text class="vr-time">{{item.sub}}</text>
            <text class="vr-ip">{{item.ip}}</text>
          </view>
          <text class="vr-go">›</text>
        </view>
      </view>
      <view class="vs-more" wx:if="{{vsHasMore}}" bindtap="loadMore" hover-class="tap-hover">
        加载更多（还剩 {{vsAll.length - vsRows.length}} 条）
      </view>
    </block>
    <view class="empty" wx:elif="{{vsLoaded}}">这个筛选下还没有访客记录</view>
</view>


  <!-- 访客明细弹层 -->
  <!-- 不要再加 catchtouchmove：它会连带取消 .vdd-list 这个 scroll-view 的内部滚动，
       页面滚动改由上面的 page-meta 关掉 -->
  <view class="vdd-mask" wx:if="{{vsDetail}}" bindtap="closeVsDetail">
    <view class="vdd-sheet" catchtap="noop">
      <view class="vdd-head">
        <text class="vdd-title">{{vsDetail.title}}</text>
        <text class="vdd-x" catchtap="closeVsDetail">✕</text>
      </view>
      <view class="vdd-sum">
        <text class="vdd-sum-i"><text class="vdd-num">{{vsDetail.total}}</text> 次访问</text>
        <text class="vdd-sum-i"><text class="vdd-num">{{vsDetail.sessions}}</text> 会话</text>
        <text class="vdd-sum-i"><text class="vdd-num">{{vsDetail.pages}}</text> 个页面</text>
        <text class="vdd-sum-ip" wx:if="{{vsDetail.ip}}">{{vsDetail.ip}}</text>
      </view>
      <scroll-view scroll-y class="vdd-list">
        <view class="vdd-empty" wx:if="{{!vsDetail.rows.length}}">这条记录在当前区间没有明细</view>
        <view class="vdd-row" wx:for="{{vsDetail.rows}}" wx:key="index">
          <text class="vdd-time">{{item.at}}</text>
          <text class="vdd-tab">{{item.tab}}</text>
          <text class="vdd-src {{item.srcCls}}">{{item.src}}</text>
          <view class="vdd-user">
            <text class="vdd-uname">{{item.nick || item.user}}</text>
            <text class="vdd-nick" wx:if="{{item.nick && item.nick !== item.user}}">{{item.user}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="vdd-foot" bindtap="closeVsDetail">关闭</view>
    </view>
  </view>
