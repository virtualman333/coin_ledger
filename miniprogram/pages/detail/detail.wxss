/* ---------- 主图 ---------- */
/* 高度交给内部 swiper 决定：固定 height + 24rpx padding 与 640rpx 轮播叠加会溢出 68rpx，
   把下方的缩略图（.thumbs）盖住 */
.hero-card {
  position: relative;
  display: flex;
  min-height: 620rpx;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 22rpx;
  background: radial-gradient(circle at 50% 45%, #ffffff 0%, #fbf9f3 100%);
  box-shadow: 0 2rpx 12rpx rgba(60, 48, 26, 0.06);
}

.hero-img {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

/* 无实拍图时是 .hero-card 的直接子节点，父级 height:auto 会让 height:100% 塌陷，需显式高度 */
.hero-card > .hero-img {
  height: 600rpx;
  background: #f3f0e9;
}

.fig-hint {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(29, 29, 31, 0.55);
  color: #f6efdf;
  font-size: 21rpx;
}

/* ---------- 标题 ---------- */
/* ---------- 多图缩略图 ---------- */
.thumbs {
  display: flex;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.thumb-item {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  margin: 0 12rpx 12rpx 0;
  border: 2rpx solid #e8e2d5;
  border-radius: 12rpx;
  overflow: hidden;
}

.thumb-item.on {
  border-color: #9a6b1f;
  box-shadow: 0 0 0 3rpx rgba(154, 107, 31, 0.18);
}

.thumb-img {
  display: block;
  width: 100%;
  height: 100%;
  background: #fff;
}


.title-block {
  padding: 30rpx 28rpx 6rpx;
}

.name {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  line-height: 1.3;
}

.title-meta {
  display: flex;
  margin-top: 14rpx;
  align-items: center;
}

.title-year,
.title-series {
  color: #6b6559;
  font-size: 24rpx;
}

.title-sep {
  margin: 0 10rpx;
  color: #8a8378;
  font-size: 22rpx;
}

.title-own {
  margin-left: 16rpx;
}

.set-line {
  display: flex;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  align-items: center;
  border-radius: 12rpx;
  background: #f6f1e4;
  justify-content: space-between;
}

.set-name {
  flex: 1;
  overflow: hidden;
  color: #6b5320;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.set-prog {
  margin-left: 12rpx;
  color: #9a6b1f;
  font-size: 22rpx;
  flex-shrink: 0;
}

/* ---------- 参数 ---------- */
.facts {
  display: flex;
  flex-wrap: wrap;
}

.fact {
  display: flex;
  width: 33.33%;
  padding: 14rpx 0;
  flex-direction: column;
}

.fact-wide {
  width: 100%;
}

.fact-k {
  color: #6b6559;
  font-size: 22rpx;
}

.fact-v {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

/* ---------- 价格 ---------- */
.price-card {
  padding: 6rpx 28rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2efe7;
}

.price-row:last-child {
  border-bottom: none;
}

.price-k {
  color: #6b6559;
  font-size: 26rpx;
}

.price-v {
  color: #9a6b1f;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

/* ---------- 操作 ---------- */
.actions {
  margin-top: 30rpx;
}

/* 次要操作：分享 / 纠错，两个等宽描边按钮 */
.act-row {
  display: flex;
  margin-top: 16rpx;
}

.act-btn {
  flex: 1;
  height: 76rpx;
  margin: 0;
  padding: 0;
  line-height: 76rpx;
  border: 1rpx solid #e2d8c4;
  border-radius: 14rpx;
  background: #ffffff;
  color: #7a541a;
  font-size: 27rpx;
  text-align: center;
}

.act-btn + .act-btn {
  margin-left: 16rpx;
}

.act-btn::after {
  border: none;
}

/* 破坏性操作弱化：小字 + 暗红，点之前还会二次确认 */
.act-remove {
  margin-top: 22rpx;
  padding: 10rpx 0;
  color: #a04a41;
  font-size: 23rpx;
  text-align: center;
}

.btn-share::after {
  border: none;
}

/* ---------- 介绍 ---------- */
.desc {
  display: block;
  color: #3a352c;
  font-size: 27rpx;
  line-height: 1.9;
  text-align: justify;
}

/* ---------- 同系列 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  margin: 0 14rpx 14rpx 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4a4438;
  font-size: 24rpx;
}

.fig-note {
  display: block;
  margin: 18rpx 4rpx 0;
  color: #6b6559;
  font-size: 20rpx;
  line-height: 1.7;
}

.fb-row {
  margin-top: 26rpx;
  padding: 14rpx 0;
  color: #6b6559;
  font-size: 22rpx;
  text-align: center;
}

/* 规格区脚注（推定值说明）与币面图案 */
.fact-note{
  display:block;margin-top:18rpx;padding-top:14rpx;
  border-top:1rpx solid #eee;font-size:22rpx;line-height:1.6;color:#6b6559
}
.pat{padding:16rpx 0;border-bottom:1rpx solid #f2f2f2}
.pat:last-child{border-bottom:0;padding-bottom:0}
.pat:first-child{padding-top:0}
.pat-k{display:block;font-size:24rpx;color:#8a6420;margin-bottom:8rpx}
.pat-v{display:block;font-size:27rpx;line-height:1.75;color:#5a5a5a}

/* 同系列预览弹窗 */
.peek-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 20, 14, 0.45);
}

.peek-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 86vh;
  padding: 0 30rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

/* 可滚动区：flex 子项要能真正收缩，必须 min-height:0 */
.peek-scroll {
  flex: 1 1 auto;
  min-height: 0;
}

.peek-head {
  display: flex;
  flex: 0 0 auto;
  padding: 28rpx 0 12rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.peek-title {
  flex: 1;
  padding-right: 20rpx;
  color: #2b2926;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.peek-x {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  margin: -14rpx -20rpx 0 0;
  align-items: center;
  justify-content: center;
  color: #6b6559;
  font-size: 28rpx;
}

.peek-body {
  padding-bottom: 6rpx;
}

.peek-img {
  display: block;
  width: 100%;
  height: 300rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
}

.peek-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 14rpx;
  color: #6b6559;
  font-size: 22rpx;
}

.peek-desc {
  display: block;
  color: #4a4438;
  font-size: 25rpx;
  line-height: 1.8;
}

.peek-empty {
  color: #6b6559;
}

.peek-foot {
  display: flex;
  flex: 0 0 auto;
  margin-top: 8rpx;
  padding-top: 18rpx;
  gap: 18rpx;
  border-top: 1rpx solid #f6f3ec;
}

.peek-btn {
  flex: 1;
  height: 86rpx;
  margin: 0;
  line-height: 86rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
}

.peek-btn.ghost {
  border: 1rpx solid #e6dfd0;
  background: #ffffff;
  color: #6b6559;
}

.peek-btn.primary {
  background: linear-gradient(135deg, #b98f43, #d9b364);
  color: #ffffff;
  font-weight: 600;
}

.peek-btn::after {
  border: none;
}

/* 主图轮播（高度与 .hero-card > .hero-img 保持一致，卡片总高 = 600 + 2*24 = 648rpx） */
.hero-swiper {
  width: 100%;
  height: 600rpx;
}

.hero-swiper .hero-img {
  width: 100%;
  height: 600rpx;
}

/* 标题 + 右侧价格 */
.title-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.title-left {
  flex: 1;
  min-width: 0;
}

.price-badge {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background: #fdf7ea;
  text-align: right;
}

.pb-main {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  color: #9a6b1f;
}

.pb-cur {
  font-size: 22rpx;
}

.pb-num {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
}

.pb-unit {
  margin-left: 2rpx;
  color: #8a6420;
  font-size: 20rpx;
}

.pb-set {
  display: block;
  margin-top: 6rpx;
  color: #6b6559;
  font-size: 21rpx;
}

.pb-tip {
  display: block;
  margin-top: 2rpx;
  color: #8a8378;
  font-size: 21rpx;
}

/* 推理价：只在详情页出现 */
.ai-row {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #faf8f3;
}

.ai-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ai-tip {
  display: block;
  margin-top: 8rpx;
  color: #8a8378;
  font-size: 21rpx;
  line-height: 1.5;
}

/* 推理价计算方式：问号 + 点击弹层 */
.ai-q {
  position: relative;
  display: inline-flex;
  width: 30rpx;
  height: 30rpx;
  margin-left: 2rpx;
  border: 1rpx solid #d8cfbe;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  color: #9a6b1f;
  font-size: 21rpx;
  line-height: 1;
}

/* 30rpx 的问号基本点不到，热区扩到 88rpx */
.ai-q::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  margin: -44rpx 0 0 -44rpx;
}

.ai-formula-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 0 40rpx;
  background: rgba(30, 24, 16, 0.5);
  align-items: center;
  justify-content: center;
  display: flex;
}

.ai-formula-panel {
  width: 100%;
  max-width: 620rpx;
  /* 兜底：小屏 / 后续文案变长时，面板本身可滚，标题栏和 × 不会被顶出屏幕 */
  max-height: 80vh;
  overflow-y: auto;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.ai-formula-h {
  display: flex;
  margin-bottom: 20rpx;
  align-items: center;
  justify-content: space-between;
  color: #2b2926;
  font-size: 30rpx;
  font-weight: 600;
}

.ai-formula-x {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  margin: -22rpx -22rpx -22rpx 0;
  align-items: center;
  justify-content: center;
  color: #6b6559;
  font-size: 40rpx;
  line-height: 1;
}

.ai-formula-body {
  color: #6a6252;
  font-size: 24rpx;
  line-height: 1.8;
}

.ai-badge {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #2b2926;
  color: #f6e7c6;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.ai-label {
  color: #6b6559;
  font-size: 22rpx;
}

.ai-value {
  color: #9a6b1f;
  font-size: 26rpx;
  font-weight: 700;
}

.ai-diff {
  margin-left: auto;
  color: #6b6559;
  font-size: 20rpx;
}
