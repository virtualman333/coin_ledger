<view class="page">
  <!-- 用户与汇总 -->
  <view class="uhead">
    <view class="uinfo">
      <view class="uavatar">{{avatarText}}</view>
      <view class="umain">
        <text class="uname">{{userName}}</text>
        <text class="usub">{{roleText}} · 注册 {{createdText}}</text>
      </view>
    </view>
    <view class="usum">
      <view class="ucell">
        <text class="uk">品种</text>
        <text class="uv">{{summary.kinds}}<text class="uk-in" wx:if="{{summary.pmKinds}}">+{{summary.pmKinds}}</text></text>
      </view>
      <view class="ucell">
        <text class="uk">成本</text>
        <text class="uv">¥{{summary.costText}}</text>
      </view>
      <view class="ucell">
        <text class="uk">市值</text>
        <text class="uv">¥{{summary.marketText}}</text>
      </view>
      <view class="ucell">
        <text class="uk">盈亏</text>
        <text class="uv {{summary.up ? 'up' : 'down'}}">{{summary.pnlText}}</text>
      </view>
    </view>
  </view>

  <view class="tip" wx:if="{{!loading}}">共 {{items.length}} 条持仓 · 仅管理员可见<text wx:if="{{summary.pmKinds}}">
其中 {{summary.pmKinds}} 条贵金属不计入市值与盈亏（成本 ¥{{summary.pmCostText}}）</text></view>

  <view class="card list" wx:if="{{items.length}}">
    <view class="hrow" wx:for="{{items}}" wx:key="id">
      <view class="hfig">
        <image class="himg" src="{{item.imgUrl}}" mode="aspectFit" wx:if="{{item.imgUrl}}"></image>
        <view class="himg hph" wx:else>无图</view>
      </view>
      <view class="hmain">
        <text class="hname">{{item.name}}</text>
        <text class="hsub">{{item.qtyLabel}}<text wx:if="{{item.faceText}}"> · 面值 ¥{{item.faceText}}</text><text wx:else> · 贵金属</text></text>
        <text class="hmeta">成本 ¥{{item.costText}} · 均价 ¥{{item.unitCostText}}</text>
      </view>
      <view class="hright">
        <block wx:if="{{item.isPm}}">
          <text class="hval is-none">—</text>
          <text class="hpnl is-none">不计估值</text>
        </block>
        <block wx:else>
          <text class="hval">¥{{item.marketText}}</text>
          <text class="hpnl {{item.pnlCls}}">{{item.pnlText}}</text>
        </block>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !items.length}}">
    <text class="e-title">这个账号还没有藏品</text>
    <text class="e-sub">等他自己记录，或者从网页端看更详细的数据</text>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中…</view>
</view>
