<view class="page">
  <!-- 用户与汇总 -->
  <view class="uhead">
    <view class="uinfo">
      <image class="uavatar uavatar-img" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}" />
      <view class="uavatar" wx:else>{{avatarText}}</view>
      <view class="umain">
        <view class="uname-row">
          <text class="uname">{{userName}}</text>
          <text class="ubadge adm" wx:if="{{isAdmin}}">管理员</text>
          <text class="ubadge test" wx:if="{{isTest}}">测试</text>
          <text class="ubadge off" wx:if="{{disabled}}">已禁用</text>
          <text class="ubadge wx" wx:if="{{wx}}">微信</text>
        </view>
        <text class="uaccount">账号 {{accountName}}</text>
        <text class="usub">{{metaText}}</text>
      </view>
    </view>
    <view class="usum">
      <view class="ucell">
        <text class="uk">品种</text>
        <text class="uv">{{summary.kinds}}<text class="uk-in" wx:if="{{summary.pmKinds}}">+{{summary.pmKinds}}</text></text>
      </view>
      <view class="ucell">
        <text class="uk">成本</text>
        <text class="uv">¥{{summary.costText}}</text>
      </view>
      <view class="ucell">
        <text class="uk">市值</text>
        <text class="uv">¥{{summary.marketText}}</text>
      </view>
      <view class="ucell">
        <text class="uk">盈亏</text>
        <text class="uv {{summary.up ? 'up' : 'down'}}">{{summary.pnlText}}</text>
      </view>
    </view>
  </view>

  <!-- 账号信息：能显示的都在这里，管理员核对账号时不用再切页 -->
  <view class="ucard">
    <view class="urow">
      <text class="uk2">用户 ID</text>
      <text class="uv2 mono">{{user.id || '—'}}</text>
    </view>
    <view class="urow">
      <text class="uk2">登录方式</text>
      <text class="uv2">{{loginText}}</text>
    </view>
    <view class="urow">
      <text class="uk2">改过名</text>
      <text class="uv2">{{nameChangedText}}</text>
    </view>
    <view class="urow">
      <text class="uk2">注册时间</text>
      <text class="uv2">{{createdText}}</text>
    </view>
    <view class="urow">
      <text class="uk2">最近登录</text>
      <text class="uv2">{{lastLoginText}}</text>
    </view>
  </view>

  <view class="tip" wx:if="{{!loading && items.length}}">{{items.length}} 条持仓<text wx:if="{{summary.pmKinds}}"> · {{summary.pmKinds}} 条贵金属不计估值</text></view>

  <view class="card list" wx:if="{{items.length}}">
    <view class="hrow" wx:for="{{items}}" wx:key="id">
      <view class="hfig">
        <image class="himg" src="{{item.imgUrl}}" mode="aspectFit" wx:if="{{item.imgUrl}}"></image>
        <view class="himg hph" wx:else>无图</view>
      </view>
      <view class="hmain">
        <text class="hname">{{item.name}}</text>
        <text class="hsub">{{item.qtyLabel}}<text wx:if="{{item.faceText}}"> · 面值 ¥{{item.faceText}}</text><text wx:else> · 贵金属</text></text>
        <text class="hmeta">成本 ¥{{item.costText}} · 均价 ¥{{item.unitCostText}}</text>
      </view>
      <view class="hright">
        <block wx:if="{{item.isPm}}">
          <text class="hval is-none">—</text>
          <text class="hpnl is-none">不计估值</text>
        </block>
        <block wx:else>
          <text class="hval">¥{{item.marketText}}</text>
          <text class="hpnl {{item.pnlCls}}">{{item.pnlText}}</text>
        </block>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !items.length}}">这个账号还没有收藏</view>

  <view class="loading" wx:if="{{loading}}">加载中…</view>
</view>
