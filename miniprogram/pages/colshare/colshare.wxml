<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <view class="err" wx:elif="{{err}}">
    <text>{{err}}</text>
    <view class="home-btn" hover-class="tap-hover" bindtap="goHome">进入藏币录 ›</view>
  </view>

  <block wx:else>
    <view class="head">
      <view class="owner">{{owner}}的收藏</view>
      <view class="sub">{{kinds}} 个品种 · {{total}} 枚/张<text wx:if="{{timeText}}"> · {{timeText}}分享</text></view>
      <view class="sum" wx:if="{{faceText || aiText}}">
        <view class="sum-i" wx:if="{{faceText}}">
          <text class="sum-k">面值合计</text>
          <text class="sum-v">¥{{faceText}}</text>
        </view>
        <view class="sum-i" wx:if="{{aiText}}">
          <text class="sum-k">推理价合计</text>
          <text class="sum-v sum-gold">¥{{aiText}}</text>
        </view>
      </view>
      <button class="share-btn" open-type="share" hover-class="tap-hover">分享给朋友</button>
    </view>

    <view class="tip" wx:if="{{!listHidden}}">仅展示品种与数量，不含成本、盈亏等账本信息</view>

    <view class="empty" wx:if="{{listHidden}}">对方只分享了汇总，没有公开品种清单</view>
    <view class="empty" wx:elif="{{!items.length}}">这份收藏还是空的</view>
    <view class="list" wx:else>
      <view class="row" wx:for="{{items}}" wx:key="index">
        <image class="thumb" wx:if="{{item.imgUrl}}" src="{{item.imgUrl}}" mode="aspectFit" data-src="{{item.imgUrl}}" bindtap="preview"></image>
        <view class="thumb-ph" wx:else>{{item.nameInitial || '藏'}}</view>
        <view class="info">
          <view class="name">{{item.name}}</view>
          <view class="meta">{{item.year ? item.year + ' 年 · ' : ''}}{{item.seriesName || '独立藏品'}}</view>
          <view class="tags" wx:if="{{item.tagText}}">{{item.tagText}}</view>
        </view>
        <view class="qty">{{item.qtyLabel}}</view>
      </view>
    </view>

    <!-- 分享落地页页面栈只有一层，必须给新用户一个进入主界面的出口 -->
    <view class="home-bar" hover-class="tap-hover" bindtap="goHome">进入藏币录，看全套图鉴 ›</view>
    <view class="foot">藏币录 · 中国纪念币图鉴与收藏记录</view>
  </block>
</view>
