.page{padding:24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));min-height:100vh;box-sizing:border-box}
.loading,.err{padding:140rpx 0;text-align:center;color:#6b6559;font-size:26rpx;line-height:1.8}

.head{padding:28rpx;border-radius:18rpx;background:linear-gradient(135deg,#b98f43 0%,#d9b364 58%,#e3c489 100%);box-shadow:0 10rpx 26rpx rgba(185,143,67,.22)}
.owner{font-size:36rpx;font-weight:700;color:#fff;line-height:1.4}
.sub{margin-top:10rpx;font-size:22rpx;color:rgba(255,255,255,.86)}
.share-btn{width:100%;margin:22rpx 0 0;padding:18rpx;border-radius:12rpx;border:1rpx solid rgba(255,255,255,.55);background:rgba(255,255,255,.18);color:#fff;font-size:25rpx;font-weight:600}
.share-btn::after{border:none}

.tip{margin:18rpx 4rpx 12rpx;font-size:20rpx;color:#6b6559;line-height:1.6}
.empty{padding:100rpx 0;text-align:center;color:#6b6559;font-size:25rpx}
.list{display:flex;flex-direction:column;gap:12rpx}
.row{display:flex;align-items:center;gap:18rpx;padding:18rpx;border-radius:14rpx;background:#fff;border:1rpx solid #ece7dc}
.thumb,.thumb-ph{flex:0 0 96rpx;width:96rpx;height:96rpx;border-radius:10rpx;background:#f3f0e9}
.thumb-ph{display:flex;align-items:center;justify-content:center;color:#6b6559;font-size:30rpx;font-weight:700}
.info{flex:1;min-width:0}
.name{font-size:26rpx;font-weight:600;color:#2a2620;line-height:1.5;word-break:break-all}
.meta{margin-top:6rpx;font-size:21rpx;color:#6b6559;line-height:1.5}
.tags{margin-top:6rpx;font-size:20rpx;color:#9a6b1f;line-height:1.5}
.qty{flex:0 0 auto;font-size:23rpx;color:#9a6b1f;font-weight:600}
.foot{margin-top:24rpx;text-align:center;font-size:20rpx;color:#6b6559}

/* 分享落地页出口：热区 ≥88rpx，让被分享吸引来的新用户能进主界面 */
.home-bar{
  margin:32rpx 24rpx 12rpx;min-height:88rpx;line-height:88rpx;text-align:center;
  border-radius:16rpx;background:#9a6b1f;color:#fff;font-size:28rpx;font-weight:600
}
.err .home-btn{
  margin:28rpx auto 0;min-height:88rpx;line-height:88rpx;width:60%;text-align:center;
  border-radius:16rpx;background:#9a6b1f;color:#fff;font-size:27rpx
}
