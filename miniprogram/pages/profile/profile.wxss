@import "../../styles/ui.wxss";

/* 个人资料：头像 + 三条只读信息，细线分隔 */

.page {
  padding-top: 12rpx;
}

.ava-wrap {
  display: flex;
  padding: 20rpx 0 36rpx;
  justify-content: center;
}

.ava-btn {
  width: 160rpx;
  height: 160rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  line-height: 1;
  overflow: hidden;
}

.ava-btn::after {
  border: none;
}

.ava {
  display: block;
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  color: #757575;
  font-size: 56rpx;
  font-weight: 500;
  line-height: 160rpx;
  text-align: center;
}

.ava-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.field {
  display: flex;
  min-height: 108rpx;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #ededed;
}

.f-k {
  width: 150rpx;
  color: #151515;
  font-size: 28rpx;
  flex: 0 0 auto;
}

.f-v {
  flex: 1;
  min-width: 0;
  color: #151515;
  font-size: 27rpx;
  text-align: right;
}

.f-ro {
  color: #757575;
}

.ph {
  color: #a5a5a5;
}

.link-row {
  margin-top: 18rpx;
  border-bottom: none;
}

.save-btn {
  margin-top: 48rpx;
}
