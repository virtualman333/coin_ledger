/* 个人资料：行样式走全局 .cell，这里只留头像与输入框 */

.page {
  padding-top: 24rpx;
}

.ava-wrap {
  display: flex;
  padding: 20rpx 0 36rpx;
  justify-content: center;
}

.ava-btn {
  width: 160rpx;
  height: 160rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  line-height: 1;
  overflow: hidden;
}

.ava-btn::after {
  border: none;
}

.ava {
  display: block;
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: #f6efe0;
  color: #8a6420;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 160rpx;
  text-align: center;
}

.ava-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 行内输入：右侧对齐 */
.f-v {
  flex: 1;
  min-width: 0;
  color: #2b2926;
  font-size: 27rpx;
  text-align: right;
}

.f-ro {
  color: #6b6559;
}

.ph {
  color: #8a8378;
}

.link-row {
  margin-top: 18rpx;
}

.save-btn {
  margin-top: 48rpx;
}

/* ---------- 用户名提示 ---------- */
.row-tip {
  margin: -6rpx 0 6rpx;
  padding: 0 4rpx;
  color: #9a6b1f;
  font-size: 20rpx;
  line-height: 1.5;
}

.row-tip-lock {
  color: #8a8378;
}

/* ---------- 改密码面板 ---------- */
.pwd-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 20, 14, 0.45);
}

.pwd-sheet {
  width: 100%;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.pwd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.pwd-title {
  color: #2b2926;
  font-size: 32rpx;
  font-weight: 600;
}

.pwd-x {
  padding: 10rpx 14rpx;
  color: #8a8378;
  font-size: 30rpx;
  line-height: 1;
}

.pwd-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f6f3ec;
}

.pwd-k {
  width: 140rpx;
  flex: 0 0 auto;
  color: #2b2926;
  font-size: 27rpx;
}

.pwd-i {
  flex: 1;
  min-width: 0;
  color: #2b2926;
  font-size: 27rpx;
}

.pwd-tip {
  display: block;
  margin: 20rpx 0 24rpx;
  color: #8a8378;
  font-size: 20rpx;
  line-height: 1.5;
}
