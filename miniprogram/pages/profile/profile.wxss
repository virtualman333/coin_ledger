/* 个人资料：行样式走全局 .cell，这里只留头像与输入框 */

.page {
  padding-top: 12rpx;
}

.ava-wrap {
  display: flex;
  padding: 20rpx 0 36rpx;
  justify-content: center;
}

.ava-btn {
  width: 160rpx;
  height: 160rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  line-height: 1;
  overflow: hidden;
}

.ava-btn::after {
  border: none;
}

.ava {
  display: block;
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: #f6efe0;
  color: #8a6420;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 160rpx;
  text-align: center;
}

.ava-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 行内输入：右侧对齐 */
.f-v {
  flex: 1;
  min-width: 0;
  color: #2b2926;
  font-size: 27rpx;
  text-align: right;
}

.f-ro {
  color: #6b6559;
}

.ph {
  color: #8a8378;
}

.link-row {
  margin-top: 18rpx;
}

.save-btn {
  margin-top: 48rpx;
}
