.page{padding:28rpx 24rpx calc(60rpx + env(safe-area-inset-bottom))}
.intro{margin-bottom:24rpx}
.intro-t{display:block;font-size:40rpx;font-weight:700;color:#2a2620}
.intro-d{display:block;margin-top:10rpx;font-size:24rpx;line-height:1.7;color:#6b6559}
.btn-primary{
  width:100%;padding:24rpx;border:0;border-radius:14rpx;
  background:#9a6b1f;color:#fff;font-size:29rpx;font-weight:600
}
/* 禁用态文字必须深色：白字在 #d9d2c5 上只有 1.5:1，「识别中…」等于看不见 */
.btn-primary[disabled]{background:#d9d2c5;color:#4a4438}
.err{margin-top:18rpx;padding:18rpx;border-radius:12rpx;background:#fff2f0;color:#b23b2e;font-size:24rpx}
.result{margin-top:28rpx;padding:28rpx;border-radius:16rpx;background:#fff;border:1rpx solid #ece7dc}
.result-head{display:flex;align-items:center;justify-content:space-between}
.result-k{font-size:26rpx;font-weight:600;color:#2a2620}
.result-note{font-size:21rpx;color:#6b6559}
.num-row{display:flex;align-items:center;justify-content:center;gap:40rpx;margin:24rpx 0 6rpx}
.num-btn{
  width:80rpx;height:80rpx;border-radius:50%;background:#f6f1e6;color:#9a6b1f;
  font-size:44rpx;line-height:76rpx;text-align:center;border:1rpx solid #e8dcc2
}
.num-main{display:flex;align-items:baseline;gap:8rpx}
.num-v{font-size:88rpx;font-weight:700;color:#9a6b1f;line-height:1}
.num-u{font-size:28rpx;color:#6b6559}
.adjust-tip{display:block;text-align:center;margin-top:10rpx;font-size:21rpx;color:#6b6559}
.marked-box{margin-top:24rpx;padding:20rpx;border-radius:16rpx;background:#fff;border:1rpx solid #ece7dc}
.marked-h{display:block;margin-bottom:12rpx;font-size:24rpx;color:#6b6459}
/* 占位高度：图片加载前块高度为 0，识别结果一出来整页会跳一下 */
.marked-img{width:100%;min-height:300rpx;border-radius:10rpx;background:#f3f0e9}
.tips{margin-top:28rpx;padding:24rpx;border-radius:14rpx;background:#faf7f0}
.tips-h{display:block;margin-bottom:12rpx;font-size:25rpx;font-weight:600;color:#6b6459}
.tips-i{display:block;font-size:23rpx;line-height:2;color:#6b6559}
.err .retry{color:#9a6b1f;font-weight:600;margin-left:8rpx}

/* 好友分享进来的邀请条：先给结论（朋友数了多少），再给入口 */
.invite{
  margin-bottom:22rpx;padding:22rpx 24rpx;border-radius:14rpx;
  background:#fdf6e6;border:1rpx solid #ecdfc4;border-left:6rpx solid #c9a45c
}
.invite-t{display:block;font-size:27rpx;font-weight:600;color:#7d5716}
.invite-d{display:block;margin-top:8rpx;font-size:22rpx;line-height:1.7;color:#6b6559}

/* 结果图分享：主按钮是「拍照」，分享是次级动作，用描边胶囊，不抢主次 */
.share-row{margin-top:26rpx;padding-top:22rpx;border-top:1rpx dashed #ece7dc;text-align:center}
.btn-share{
  display:inline-block;padding:0 46rpx;height:78rpx;line-height:76rpx;border-radius:39rpx;
  background:#fff;border:1rpx solid #d9c39a;color:#9a6b1f;font-size:27rpx;font-weight:600
}
.btn-share.tap-hover,.tap-hover.btn-share{background:#faf3e4}
.share-tip{display:block;margin-top:14rpx;font-size:21rpx;line-height:1.6;color:#6b6559}

/* 海报画布挪到屏幕外：必须有布局尺寸（canvas 2d 在 display:none 下画不出来），
   逻辑像素由 JS 里的 canvas.width/height 决定，这里只影响它在屏幕上的占位大小 */
.poster-canvas{
  position:fixed;left:-9999rpx;top:0;width:540rpx;height:675rpx;
  pointer-events:none;opacity:0
}
