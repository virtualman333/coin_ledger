/* 拍照数币：浅灰底 + 白色大圆角卡片 + 一枚琥珀色主按钮，整页只留一个视觉重心 */
page{background:#f4f5f6}

.page{padding:24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom))}

/* ---------- 标题 ---------- */
.hero{margin:12rpx 4rpx 26rpx}
.hero-t{display:block;font-size:44rpx;line-height:1.35;font-weight:700;color:#1d1d1f;letter-spacing:.5rpx}
.hero-d{display:block;margin-top:14rpx;font-size:24rpx;line-height:1.75;color:#7a7d82}

/* ---------- 照片区 ---------- */
.shot{
  position:relative;
  width:100%;
  height:660rpx;
  border-radius:26rpx;
  background:#ffffff;
  box-shadow:0 2rpx 16rpx rgba(20,20,20,.04);
  overflow:hidden;
}
.shot-img{width:100%;height:100%;display:block;background:#ffffff}
.shot-tag{
  position:absolute;left:20rpx;bottom:20rpx;
  padding:8rpx 18rpx;border-radius:999rpx;
  background:rgba(255,255,255,.92);color:#8a6420;
  font-size:21rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.06)
}
.shot-busy{
  position:absolute;left:0;right:0;top:0;bottom:0;display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,.72);color:#8a6420;font-size:26rpx;font-weight:600
}

.shot-empty{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  width:100%;height:100%;
}

/* 硬币图标：银色币面 + 偏移的琥珀色光环，纯 CSS，不占图片资源 */
.coin{position:relative;width:132rpx;height:132rpx;margin-bottom:26rpx}
.coin-ring{
  position:absolute;left:22rpx;top:16rpx;width:110rpx;height:110rpx;
  border:5rpx solid #d8b878;border-radius:50%;opacity:.75
}
.coin-face{
  position:absolute;left:0;top:0;width:112rpx;height:112rpx;border-radius:50%;
  background:linear-gradient(160deg,#d9d9d9 0%,#bcbcbc 55%,#a8a8a8 100%);
  box-shadow:inset 0 -3rpx 8rpx rgba(0,0,0,.12),0 2rpx 8rpx rgba(0,0,0,.08);
  display:flex;align-items:center;justify-content:center
}
.coin-hole{
  width:34rpx;height:34rpx;border-radius:8rpx;
  background:#f4f5f6;box-shadow:inset 0 2rpx 6rpx rgba(0,0,0,.18)
}
.shot-hint{color:#9a9ea4;font-size:24rpx}

/* ---------- 主按钮 ---------- */
.btn-primary{
  width:100%;height:96rpx;line-height:96rpx;margin-top:26rpx;padding:0;
  border:0;border-radius:18rpx;
  background:#8f6a1f;color:#ffffff;font-size:30rpx;font-weight:600;letter-spacing:1rpx
}
.btn-primary::after{border:none}
.btn-primary[disabled]{background:#d9d2c5;color:#4a4438}

.err{margin-top:18rpx;padding:18rpx 20rpx;border-radius:14rpx;background:#fff2f0;color:#b23b2e;font-size:24rpx}
.err .retry{color:#8f6a1f;font-weight:600;margin-left:8rpx}

/* ---------- 通用白卡 ---------- */
.card{
  margin-top:24rpx;padding:28rpx;border-radius:22rpx;
  background:#ffffff;box-shadow:0 2rpx 16rpx rgba(20,20,20,.04)
}

/* ---------- 结果 ---------- */
.result-head{display:flex;align-items:center;justify-content:space-between}
.result-k{font-size:26rpx;font-weight:600;color:#1d1d1f}
.result-note{font-size:21rpx;color:#8a8e94}
.num-row{display:flex;align-items:center;justify-content:center;gap:40rpx;margin:24rpx 0 6rpx}
.num-btn{
  width:80rpx;height:80rpx;border-radius:50%;background:#f7f3ea;color:#8f6a1f;
  font-size:44rpx;line-height:76rpx;text-align:center;border:1rpx solid #e8dcc2
}
.num-main{display:flex;align-items:baseline;gap:8rpx}
.num-v{font-size:88rpx;font-weight:700;color:#8f6a1f;line-height:1}
.num-u{font-size:28rpx;color:#7a7d82}
.adjust-tip{display:block;text-align:center;margin-top:10rpx;font-size:21rpx;color:#8a8e94}

/* 分享是次级动作：描边胶囊，不抢主按钮 */
.share-row{margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid #f2f2f2;text-align:center}
.btn-share{
  display:inline-block;padding:0 46rpx;height:78rpx;line-height:76rpx;border-radius:39rpx;
  background:#ffffff;border:1rpx solid #d9c39a;color:#8f6a1f;font-size:27rpx;font-weight:600
}
.btn-share.tap-hover,.tap-hover.btn-share{background:#faf3e4}
.share-tip{display:block;margin-top:14rpx;font-size:21rpx;line-height:1.6;color:#8a8e94}

/* ---------- 拍摄建议 ---------- */
.tips-h{display:block;margin-bottom:16rpx;font-size:27rpx;font-weight:700;color:#1d1d1f}
.tip-i{display:flex;align-items:flex-start;gap:12rpx;margin-top:12rpx}
.dot{
  flex:0 0 auto;width:8rpx;height:8rpx;border-radius:50%;
  background:#c9a45c;margin-top:14rpx
}
.tip-t{flex:1;font-size:23rpx;line-height:1.85;color:#7a7d82}

/* ---------- 好友分享邀请条 ---------- */
.invite{
  margin-bottom:22rpx;padding:22rpx 24rpx;border-radius:18rpx;
  background:#fdf7ea;border-left:6rpx solid #c9a45c
}
.invite-t{display:block;font-size:27rpx;font-weight:600;color:#7d5716}
.invite-d{display:block;margin-top:8rpx;font-size:22rpx;line-height:1.7;color:#7a7d82}

/* 海报画布挪到屏幕外：必须有布局尺寸（canvas 2d 在 display:none 下画不出来），
   逻辑像素由 JS 里的 canvas.width/height 决定，这里只影响它在屏幕上的占位大小 */
.poster-canvas{
  position:fixed;left:-9999rpx;top:0;width:540rpx;height:675rpx;
  pointer-events:none;opacity:0
}
