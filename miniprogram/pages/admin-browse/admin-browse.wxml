<view class="page">
  <!-- 面包屑：任何一层都能直接退回上一层 -->
  <view class="crumbs" wx:if="{{level > 0}}">
    <text class="cb" hover-class="tap-hover" bindtap="goRoot">资料库</text>
    <text class="cb-sep">›</text>
    <text class="cb" wx:if="{{level === 2}}" hover-class="tap-hover" bindtap="goSeriesList">{{catName}}</text>
    <text class="cb-sep" wx:if="{{level === 2}}">›</text>
    <text class="cb-cur">{{title}}</text>
  </view>

  <!-- 第一层：大品类 -->
  <block wx:if="{{level === 0}}">
    <view class="hint">从品类往下钻：系列 → 单枚，单枚里能改参数和图片</view>
    <view
      class="lcard"
      wx:for="{{cats}}"
      wx:key="key"
      data-key="{{item.key}}"
      hover-class="tap-hover"
      hover-stay-time="80"
      bindtap="openCat"
    >
      <view class="lc-ico">{{item.icon}}</view>
      <view class="lc-txt">
        <text class="lc-t">{{item.name}}</text>
        <text class="lc-s" wx:if="{{!item.pm}}">{{item.count}} 枚 · {{item.seriesCount}} 个系列</text>
        <text class="lc-s" wx:else>全量库 · 逐枚检索</text>
      </view>
      <text class="lc-a">›</text>
    </view>
  </block>

  <!-- 第二层：系列 -->
  <block wx:elif="{{level === 1}}">
    <view
      class="lcard"
      wx:for="{{series}}"
      wx:key="key"
      data-key="{{item.key}}"
      hover-class="tap-hover"
      hover-stay-time="80"
      bindtap="openSeries"
    >
      <view class="lc-txt">
        <text class="lc-t">{{item.name}}</text>
        <text class="lc-s">
          {{item.count}} 枚<text wx:if="{{item.yearFrom}}"> · {{item.yearFrom}}—{{item.yearTo}}</text>
        </text>
      </view>
      <text class="lc-a">›</text>
    </view>
  </block>

  <!-- 第三层：单枚（可以继续改参数 / 换图） -->
  <block wx:else>
    <view class="coin" wx:for="{{coins}}" wx:key="id">
      <image class="co-img" src="{{item.img}}" mode="aspectFit" lazy-load wx:if="{{item.img}}"></image>
      <view class="co-ph" wx:else>币</view>
      <view class="co-txt">
        <text class="co-n">{{item.name}}</text>
        <text class="co-s">{{item.year}}<text wx:if="{{item.faceText}}"> · {{item.faceText}}</text></text>
      </view>
      <view class="co-acts">
        <text
          class="co-btn"
          data-act="params"
          data-name="{{item.name}}"
          hover-class="tap-hover"
          catchtap="openEdit"
        >参数</text>
        <text
          class="co-btn"
          data-act="images"
          data-name="{{item.name}}"
          hover-class="tap-hover"
          catchtap="openEdit"
        >图片</text>
      </view>
    </view>
  </block>
</view>
