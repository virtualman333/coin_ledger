@import "../admin/admin-common.wxss";

/* ================= 资料库：品类 → 系列 → 单枚 ================= */
.crumbs {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 4rpx 18rpx;
  font-size: 22rpx;
}

.cb {
  color: #8a6420;
}

.cb-sep {
  color: #c9bca2;
}

.cb-cur {
  color: #2b2926;
  font-weight: 600;
}

.hint {
  padding: 0 4rpx 18rpx;
  color: #6b6559;
  font-size: 21rpx;
  line-height: 1.5;
}

/* 品类 / 系列卡片 */
.lcard {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 14rpx;
  padding: 26rpx 24rpx;
  border-radius: 18rpx;
  border: 1rpx solid #ece7dc;
  background: #ffffff;
}

.lc-ico {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #faf8f3;
  color: #8a6420;
  font-size: 30rpx;
  line-height: 1;
}

.lc-txt {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.lc-t {
  color: #2b2926;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.lc-s {
  color: #6b6559;
  font-size: 21rpx;
  line-height: 1.3;
}

.lc-a {
  flex: 0 0 auto;
  color: #c9bca2;
  font-size: 30rpx;
  line-height: 1;
}

/* 单枚 */
.coin {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 12rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid #ece7dc;
  background: #ffffff;
}

.co-img,
.co-ph {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 auto;
  border-radius: 12rpx;
  background: #f6f3ec;
}

.co-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8378;
  font-size: 32rpx;
  font-weight: 700;
}

.co-txt {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.co-n {
  color: #2b2926;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.co-s {
  color: #6b6559;
  font-size: 21rpx;
  line-height: 1.3;
}

.co-acts {
  display: flex;
  flex: 0 0 auto;
  gap: 10rpx;
}

.co-btn {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e6dfd0;
  background: #faf8f3;
  color: #8a6420;
  font-size: 21rpx;
  line-height: 1;
}
