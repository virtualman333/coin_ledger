.plaza{padding:20rpx 24rpx 60rpx;background:#f6f4ef;min-height:100vh}
.pz-tabs{display:flex;gap:16rpx;margin-bottom:20rpx}
.pz-tab{
  font-size:26rpx;padding:10rpx 30rpx;border-radius:999rpx;
  background:#fff;color:#8a8378;border:1rpx solid #e8e2d5
}
.pz-tab.on{color:#9a6b1f;border-color:#9a6b1f;background:#faf3e2}
.pz-share-bar{
  text-align:center;padding:20rpx;margin-bottom:20rpx;border-radius:16rpx;
  background:#9a6b1f;color:#fff;font-size:28rpx
}
.pz-empty{text-align:center;color:#8a8378;padding:80rpx 20rpx;font-size:26rpx}
.pz-list{display:flex;flex-direction:column;gap:24rpx}
.pz-card{background:#fff;border-radius:18rpx;padding:24rpx;box-shadow:0 4rpx 18rpx rgba(60,44,20,.05)}
.pz-head{display:flex;align-items:center;gap:14rpx}
.pz-avatar{width:60rpx;height:60rpx;border-radius:50%}
.pz-avatar.ph{
  display:flex;align-items:center;justify-content:center;background:#faf3e2;color:#9a6b1f;font-size:26rpx
}
.pz-author{font-size:28rpx;font-weight:500;color:#241f16}
.pz-time{font-size:22rpx;color:#a0998a;margin-left:auto}
.pz-pics{display:flex;gap:10rpx;margin-top:18rpx;overflow-x:auto}
.pz-pics image{width:180rpx;height:180rpx;flex:0 0 180rpx;border-radius:14rpx}
.pz-body{margin-top:16rpx}
.pz-title{font-size:30rpx;font-weight:500;color:#241f16}
.pz-form{font-size:20rpx;color:#a0998a;border:1rpx solid #e8e2d5;border-radius:6rpx;padding:2rpx 10rpx;margin-left:10rpx}
.pz-serials{font-size:24rpx;color:#6a6252;margin-top:8rpx;word-break:break-all}
.pz-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}
.pz-tag{font-size:22rpx;padding:4rpx 16rpx;border-radius:999rpx;background:#f6f4ef;color:#8a8378}
.pz-tag.rar2{color:#9a6b1f;background:#faf3e2}
.pz-tag.rar3{color:#2f6eb0;background:#eaf2fb}
.pz-tag.rar4{color:#8a4fc0;background:#f3eafa}
.pz-tag.rar5{color:#c0456b;background:#fbeaf0}
.pz-caption{font-size:26rpx;color:#6a6252;line-height:1.6;margin-top:12rpx}
.pz-acts{display:flex;gap:28rpx;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #efe9dc}
.pz-act{font-size:26rpx;color:#8a8378}
.pz-act.on{color:#c0456b}
.pz-act.del{margin-left:auto;color:#c0392b}
.pz-comments{margin-top:16rpx;padding-top:16rpx;border-top:1rpx dashed #e8e2d5}
.pz-cmt{font-size:25rpx;line-height:1.6;color:#6a6252;margin-bottom:10rpx}
.pz-cmt-author{color:#241f16;font-weight:500;margin-right:10rpx}
.pz-cmt-time{color:#a0998a;font-size:22rpx;margin-left:12rpx}
.pz-cmt-form{display:flex;gap:14rpx;align-items:center;margin-top:14rpx}
.pz-cmt-form input{
  flex:1;background:#f6f4ef;border-radius:10rpx;padding:14rpx 18rpx;font-size:25rpx;color:#241f16
}
.pz-send{color:#9a6b1f;font-size:26rpx;padding:10rpx 20rpx}
.pz-more{text-align:center;padding:24rpx;color:#9a6b1f;font-size:26rpx}
