<view class="page">
  <view class="target" wx:if="{{coinName}}">
    <text class="target-k">反馈对象</text>
    <text class="target-v">{{coinName}}</text>
  </view>

  <view class="card box">
    <textarea
      class="ta"
      value="{{text}}"
      placeholder="哪一项不对？比如：面额应为 5 元 / 发行量少了个 0 / 图片不是这一枚"
      placeholder-class="ph"
      maxlength="{{maxLen}}"
      auto-height
      bindinput="onInput"
      show-confirm-bar="{{false}}"
    ></textarea>
    <text class="count">{{text.length}} / {{maxLen}}</text>
  </view>

  <view class="pics">
    <view class="pic" wx:for="{{images}}" wx:key="*this" data-i="{{index}}" bindtap="previewImage">
      <image class="pic-img" src="{{item}}" mode="aspectFill"></image>
      <view class="pic-del" data-i="{{index}}" catchtap="removeImage">×</view>
    </view>
    <view class="pic add" wx:if="{{images.length < 3}}" hover-class="tap-hover" bindtap="addImage">
      <text class="add-plus">+</text>
      <text class="add-t">加图片</text>
    </view>
  </view>

  <button class="btn-primary submit" bindtap="submit" loading="{{busy}}">提交反馈</button>
  <text class="tip">提交的内容会先经过安全检测，通过后才会送达管理员</text>
</view>
