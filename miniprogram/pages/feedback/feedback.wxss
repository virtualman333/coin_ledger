.target {
  display: flex;
  padding: 8rpx 8rpx 22rpx;
  align-items: baseline;
}

.target-k {
  color: #6b6559;
  font-size: 22rpx;
}

.target-v {
  margin-left: 14rpx;
  color: #2b2926;
  font-size: 26rpx;
  font-weight: 600;
}

.box {
  position: relative;
  padding: 24rpx 26rpx 40rpx;
}

.ta {
  width: 100%;
  min-height: 220rpx;
  color: #2b2926;
  font-size: 26rpx;
  line-height: 1.7;
}

.ph {
  color: #8a8378;
}

.count {
  position: absolute;
  right: 26rpx;
  bottom: 16rpx;
  color: #8a8378;
  font-size: 20rpx;
}

.pics {
  display: flex;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.pic {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 14rpx;
  overflow: hidden;
  background: #fbf9f4;
}

.pic-img {
  width: 100%;
  height: 100%;
}

/* 44rpx(22px) 太小，手指按不准；放大到 64rpx 并在视觉上仍贴角 */
.pic-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 64rpx;
  height: 64rpx;
  border-bottom-left-radius: 18rpx;
  background: rgba(20, 17, 12, 0.6);
  color: #fff;
  font-size: 30rpx;
  line-height: 60rpx;
  text-align: center;
}

.pic.add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #ddd5c5;
  background: #ffffff;
  flex-direction: column;
}

.add-plus {
  color: #8a8378;
  font-size: 44rpx;
  line-height: 1;
}

.add-t {
  margin-top: 8rpx;
  color: #8a8378;
  font-size: 20rpx;
}

.submit {
  margin-top: 34rpx;
}

.tip {
  display: block;
  margin-top: 18rpx;
  color: #6b6559;
  font-size: 20rpx;
  text-align: center;
}
