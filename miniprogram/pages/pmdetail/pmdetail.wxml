<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <view class="err-state" wx:elif="{{err}}">
    <text class="err-text">{{err}}</text>
    <view class="err-acts">
      <view class="err-btn" wx:if="{{retryable}}" hover-class="tap-hover" bindtap="retry">重新加载</view>
      <view class="err-btn ghost" hover-class="tap-hover" bindtap="goHome">回到首页</view>
    </view>
  </view>

  <block wx:if="{{item}}">
    <view class="title">
      <text class="h1">{{item.name}}</text>
      <text class="h2">{{item.projectName}} · {{item.year}}</text>
    </view>

    <view class="figs">
      <view class="fig" wx:if="{{item.frontUrl || item.frontDesc}}">
        <image wx:if="{{item.thumbUrl || item.frontUrl}}" src="{{item.thumbUrl || item.frontUrl}}" mode="aspectFit" data-src="{{item.frontUrl}}" bindtap="preview"></image>
        <view class="fig-na" wx:else>正面图暂缺</view>
        <text class="cap"><text class="cap-k">正面</text>{{item.frontDesc}}</text>
      </view>
      <view class="fig" wx:if="{{item.backUrl || item.backDesc}}">
        <image wx:if="{{item.backUrl}}" src="{{item.backUrl}}" mode="aspectFit" data-src="{{item.backUrl}}" bindtap="preview"></image>
        <view class="fig-na" wx:else>背面图暂缺</view>
        <text class="cap"><text class="cap-k">背面</text>{{item.backDesc}}</text>
      </view>
    </view>

    <view class="card">
      <text class="card-h">规格参数</text>
      <view class="facts">
        <view class="cf" wx:for="{{item.facts}}" wx:key="0"><text class="cf-k">{{item[0]}}</text><text class="cf-v">{{item[1]}}</text></view>
      </view>
    </view>

    <view class="mv-box" wx:if="{{item.metalValue}}">
      <view class="mv-row"><text class="mv-k">克重价</text><text class="mv-v">{{item.metalValue.valueText}}</text><text class="mv-u">{{item.metalValue.name}} ¥{{item.metalValue.cnyPerGram}}/克</text></view>
      <text class="mv-tip">{{item.metalValue.tip}}</text>
    </view>

    <view class="card" wx:if="{{item.announceText}}">
      <text class="card-h">发行公告</text>
      <text class="ann">{{item.announceText}}</text>
    </view>

    <!-- 同系列：贵金属的「系列」= 发行项目，横向列出同项目其他币 -->
    <view class="card sib-card" wx:if="{{siblings.length}}">
      <view class="sib-head">
        <text class="card-h">同系列</text>
        <text class="sib-more" hover-class="tap-hover" bindtap="goSeries" wx:if="{{item.projectCode}}">
          {{item.projectName}} · {{siblingTotal}} 枚 ›
        </text>
      </view>
      <scroll-view class="sib-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view
          class="sib"
          wx:for="{{siblings}}"
          wx:key="code"
          data-code="{{item.code}}"
          hover-class="tap-hover"
          bindtap="goSibling"
        >
          <view class="sib-img-w">
            <image class="sib-img" src="{{item.thumbUrl}}" mode="aspectFit" lazy-load wx:if="{{item.thumbUrl}}"></image>
            <view class="sib-ph" wx:else>暂无图</view>
          </view>
          <text class="sib-name">{{item.name}}</text>
          <text class="sib-meta">{{item.year}}{{item.weight ? ' · ' + item.weight : ''}}</text>
        </view>
      </scroll-view>
    </view>

    <button class="pm-fav {{owned ? 'is-owned' : ''}}" wx:if="{{!maintenance}}" bindtap="toggleFav" disabled="{{busy}}">{{busy ? '处理中…' : (owned ? '✓ 已在收藏 · 点此取消' : '＋ 加入我的收藏')}}</button>
    <button class="pm-share" open-type="share" hover-class="tap-hover">分享给朋友</button>
    <view class="foot">资料来源：中国人民银行发行公告 · 中国金币集团</view>
    <view class="foot">克重价按实时金银价与成色净重估算，仅材料价值；贵金属纪念币无稳定二级市场报价，本站不提供市场估值。</view>
  </block>
</view>
