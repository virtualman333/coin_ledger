<view class="page">
  <view class="hold-cats">
    <view wx:for="{{holdCats}}" wx:key="code" class="hc {{holdCat === item.code ? 'on' : ''}}" data-cat="{{item.code}}" bindtap="switchCat">{{item.name}}</view>
  </view>
  <block wx:if="{{loggedIn}}">
    <!-- 汇总：只展示面值 / 推理价 / 成本。贵金属既不算面值也没有推理价，
         纯贵金属账本上如果照搬这三块，会是一屏 ¥0.00 —— 改成按枚数展示 -->
    <view class="hero" wx:if="{{!empty}}">
      <view class="hero-top">
        <view class="hero-left">
          <text class="hero-k">{{summary.kinds ? '推理价合计' : '贵金属收藏'}}</text>
          <view class="hero-val">
            <text class="hv-cur" wx:if="{{summary.kinds}}">¥</text>
            <text class="hv-num">{{summary.kinds ? stats.aiText : summary.pmRolls}}</text>
            <text class="hv-unit" wx:if="{{!summary.kinds}}">枚</text>
          </view>
        </view>
        <view class="hero-right">
          <text class="hero-item" wx:if="{{summary.kinds}}">{{summary.kinds}} 个品种</text>
          <text class="hero-item" wx:if="{{summary.rolls}}">{{summary.rolls}} 套</text>
          <text class="hero-item" wx:if="{{summary.pmKinds}}">{{summary.pmKinds}} 种贵金属</text>
        </view>
      </view>
      <view class="hero-bottom">
        <view class="hero-cell" wx:if="{{summary.kinds}}">
          <text class="hc-k">总面值</text>
          <text class="hc-v">¥{{stats.faceText}}</text>
        </view>
        <view class="hero-cell">
          <text class="hc-k">成本合计</text>
          <text class="hc-v">¥{{stats.costText}}</text>
        </view>
      </view>
    </view>

    <view class="empty-card" wx:if="{{empty}}">
      <text class="empty-title">还没有收藏</text>
      <view class="empty-btn" hover-class="tap-hover" bindtap="goList">去挑品种</view>
    </view>

    <block wx:if="{{!empty}}">
      <view class="cat-empty" wx:if="{{catEmpty}}">
        <text class="cat-empty-t">这个分类下还没有收藏</text>
      </view>

      <block wx:if="{{!catEmpty}}">
      <!-- 工具条：左边是列表折叠（轻量），右边是分享动作（胶囊按钮）。
           以前三个都是同色纯文字，看不出主次，也看不出哪个是动作哪个是开关 -->
      <view class="tools">
        <view class="tools-btn" hover-class="tap-hover" bindtap="toggleAll">
          <text>{{allOpen ? '收起分组' : '展开全部'}}</text>
          <text class="tools-arrow {{allOpen ? 'up' : ''}}">▾</text>
        </view>

        <view class="tools-acts">
          <button class="tools-share" bindtap="openShareSheet" hover-class="tap-hover">
            <text class="tools-share-ico">↗</text>
            <text>分享我的收藏</text>
          </button>
        </view>
      </view>

      <block wx:for="{{groups}}" wx:key="name" wx:for-item="group" wx:for-index="gi">
        <view class="ghead" hover-class="tap-hover" data-gi="{{gi}}" bindtap="toggleGroup">
          <view class="ghead-left">
            <text class="gname">{{group.name}}</text>
            <text class="gprog">{{group.progLabel}}</text>
          </view>
          <view class="ghead-right">
            <!-- 贵金属没有推理价：左侧 gprog 已经写了「N 枚」，这里不要再重复一遍 -->
            <text class="gsum" wx:if="{{!group.isPm}}">推理价 ¥{{group.aiText}}</text>
            <text class="gchev">{{group.open ? '▾' : '▸'}}</text>
          </view>
        </view>

        <view class="gwrap" wx:if="{{group.open}}">
          <!-- 贵金属没有「系列进度」可算，画一条永远空着的进度条只是干扰 -->
          <view class="gbar" wx:if="{{!group.isPm}}"><view class="gbar-fill" style="width:{{group.pct}}%;min-width:{{group.pct > 0 ? 8 : 0}}rpx"></view></view>

          <view
            class="hcard"
            wx:for="{{group.items}}"
            wx:key="id"
            wx:for-index="ii"
            wx:for-item="item"
            data-id="{{item.coinId}}" data-ispm="{{item.isPm}}" data-pmcode="{{item.pmCode}}"
            bindtap="goDetail"
            hover-class="tap-hover"
          >
            <view class="hc-fig">
              <image
                wx:if="{{!item.imgFail}}"
                class="hc-img"
                src="{{item.imgUrl}}"
                mode="aspectFit"
                data-g="{{gi}}"
                data-i="{{ii}}"
                binderror="imgErr"
              ></image>
              <view wx:else class="hc-img hc-ph">无图</view>
            </view>

            <view class="hc-main">
              <text class="hc-name">{{item.name}}</text>
              <text class="hc-sub">{{item.qtyText}}<text wx:if="{{item.faceText}}"> · 面值 ¥{{item.faceText}}</text></text>
              <view class="hc-meta">
                <text>成本 ¥{{item.costText}}</text>
                <text class="hc-sep" wx:if="{{item.aiText}}">·</text>
                <text wx:if="{{item.aiText}}">推理价 ¥{{item.aiText}}</text>
              </view>
            </view>

            <!-- 唯一的编辑入口：显式的「⋯」。左滑与长按都已去掉，
                 隐藏手势在账本页里既不可发现，又容易和上下滚动抢手势 -->
            <view
              class="hc-more"
              data-g="{{gi}}"
              data-i="{{ii}}"
              catchtap="openSheet"
              hover-class="tap-hover"
              hover-stay-time="80"
              aria-role="button"
              aria-label="编辑 {{item.name}}"
            >⋯</view>
          </view>
        </view>
      </block>

      <view class="foot-hint">点每张卡右侧的 ⋯ 可以改数量、改成本，或移出账本</view>
      </block>
    </block>

    <view class="foot-note" wx:if="{{syncTip}}">{{syncTip}}</view>
  </block>

  <view class="guest-card" wx:else>
    <text class="guest-title">登录后才有账本</text>
    <text class="guest-sub">登录后你的收藏会存在云端，换设备也能接着记</text>
    <button class="btn-primary guest-btn" bindtap="goAccount">登录 / 注册</button>
  </view>
</view>

<!-- 编辑面板：改数量 / 成本 / 号码 / 形态 / 图片 / 移出 -->
<view class="sheet-mask" wx:if="{{sheet}}" bindtap="closeSheet" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head">
      <image class="sheet-img" src="{{sheet.imgUrl}}" mode="aspectFit" wx:if="{{sheet.imgUrl}}"></image>
      <view class="sheet-info">
        <text class="sheet-name">{{sheet.name}}</text>
        <text class="sheet-sub">{{sheet.qtyLabel}}<text wx:if="{{!sheet.isPm}}"> · 推理价 ¥{{sheet.aiText}}</text></text>
      </view>
      <text class="sheet-link" hover-class="tap-hover" bindtap="goSheetDetail">资料</text>
      <text class="sheet-x" hover-class="tap-hover" bindtap="closeSheet">✕</text>
    </view>

    <!-- 中间内容走 scroll-view：遮罩上的 catchtouchmove 会阻断普通 view 的原生滚动，
         而 scroll-view 自带滚动容器，能在不穿透页面的前提下正常滚动。头尾固定，✕ 和「保存」永远可达 -->
    <scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="sheet-row">
        <text class="sr-k">数量</text>
        <view class="stepper">
          <view class="step" hover-class="tap-hover" data-delta="-1" bindtap="sheetStep">−</view>
          <text class="step-num">{{sheet.rolls}} {{sheet.unitWord}}</text>
          <view class="step" hover-class="tap-hover" data-delta="1" bindtap="sheetStep">+</view>
        </view>
      </view>

      <view class="sheet-row">
        <text class="sr-k">{{sheet.costLabel || '每套成本'}}</text>
        <view class="sr-input">
          <text class="sr-cur">¥</text>
          <input
            class="sr-field"
            type="digit"
            value="{{sheet.unitCost}}"
            focus="{{sheet.focus === 'cost'}}"
            bindinput="onSheetCost"
            placeholder="0"
            placeholder-class="ph"
          />
        </view>
      </view>

      <!-- 收藏增强：纪念钞号码 + 花样 -->
      <view class="sheet-row ex-row" wx:if="{{sheet.isNote}}">
        <text class="sr-k">号码</text>
        <textarea class="sr-textarea" value="{{sheet.serialsText}}" bindinput="onSheetSerials" placeholder="输入冠字号码，多个换行" placeholder-class="ph" auto-height maxlength="-1"></textarea>
      </view>
      <view class="sheet-row ex-row" wx:if="{{sheet.isNote && sheet.luckyTags.length}}">
        <text class="sr-k">花样</text>
        <view class="sr-tags">
          <text class="sr-tag rar{{item.rarity}}" wx:for="{{sheet.luckyTags}}" wx:key="name">{{item.name}}</text>
        </view>
      </view>

      <!-- 整套 / 单个（贵金属入账就是按枚，没有套的概念） -->
      <view class="sheet-row ex-row" wx:if="{{!sheet.isPm}}">
        <text class="sr-k">形态</text>
        <view class="sr-segs">
          <text class="sr-seg {{sheet.form !== 'single' ? 'on' : ''}}" data-form="" bindtap="setForm">整套</text>
          <text class="sr-seg {{sheet.form === 'single' ? 'on' : ''}}" data-form="single" bindtap="setForm">单个</text>
        </view>
      </view>

      <!-- 我的图片（最多 3 张） -->
      <view class="sheet-row ex-row">
        <text class="sr-k">图片</text>
        <view class="sr-imgs">
          <view class="sr-img" wx:for="{{sheet.images}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill" data-idx="{{index}}" bindtap="delImage"></image>
            <text class="sr-img-x" data-idx="{{index}}" bindtap="delImage">×</text>
          </view>
          <view class="sr-img-add" hover-class="tap-hover" wx:if="{{sheet.images.length < 3}}" bindtap="addImage">+</view>
        </view>
      </view>

      <text class="sheet-tip">改成本只影响你的账本，不会改推理价</text>
    </scroll-view>

    <view class="sheet-acts">
      <button class="act ghost" bindtap="sheetRemove">移出收藏</button>
      <button class="act primary" bindtap="saveSheet">保存</button>
    </view>
  </view>
</view>

<!-- 分享内容选择：勾完再分享，落地页只出现勾中的信息 -->
<view class="sh-mask" wx:if="{{shareOpen}}" bindtap="closeShare" catchtouchmove="noop">
  <view class="sh-sheet" catchtap="noop">
    <view class="sh-head">
      <text class="sh-title">分享内容</text>
      <text class="sh-x" hover-class="tap-hover" bindtap="closeShare">✕</text>
    </view>
    <text class="sh-tip">勾选要展示给对方的；成本等账本信息永远不会分享</text>

    <view class="sh-list">
      <view
        class="sh-row"
        wx:for="{{shareOptList}}"
        wx:key="key"
        data-key="{{item.key}}"
        hover-class="tap-hover"
        bindtap="toggleShareOpt"
      >
        <view class="sh-box {{shareOpts[item.key] ? 'on' : ''}}">{{shareOpts[item.key] ? '✓' : ''}}</view>
        <view class="sh-txt">
          <text class="sh-k">{{item.name}}</text>
          <text class="sh-d">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <button class="btn-primary sh-go" open-type="share" disabled="{{shareBusy}}">
      {{shareBusy ? '正在生成…' : '分享给朋友'}}
    </button>
  </view>
</view>
