/* ================= 顶部汇总 ================= */
.hero {
  position: relative;
  margin-bottom: 18rpx;
  padding: 30rpx 30rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #b98f43 0%, #d9b364 58%, #e3c489 100%);
  box-shadow: 0 12rpx 30rpx rgba(185, 143, 67, 0.25);
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-left {
  flex: 1;
  min-width: 0;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-k {
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
}

.hero-val {
  display: flex;
  margin-top: 8rpx;
  align-items: baseline;
  color: #ffffff;
}

.hv-cur {
  font-size: 26rpx;
}

/* 只有贵金属时的量词「枚」，与 ¥ 同尺寸 */
.hv-unit {
  margin-left: 6rpx;
  font-size: 26rpx;
}

.hv-num {
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.5rpx;
}

.hero-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  padding-top: 4rpx;
}

.hero-item {
  color: rgba(255, 255, 255, 0.86);
  font-size: 21rpx;
}

.hero-bottom {
  display: flex;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.24);
}

.hero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hc-k {
  color: rgba(255, 255, 255, 0.75);
  font-size: 20rpx;
}

.hc-v {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

/* 当前分类下没有藏品（但账本里别处有） */
.cat-empty {
  margin-top: 8rpx;
  padding: 64rpx 40rpx;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
}

.cat-empty-t {
  display: block;
  color: #2b2926;
  font-size: 27rpx;
  font-weight: 600;
}


/* ================= 空态 ================= */
.empty-card {
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  display: block;
  color: #2b2926;
  font-size: 30rpx;
  font-weight: 600;
}


.empty-btn {
  display: inline-block;
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #b98f43, #d9b364);
  color: #ffffff;
  font-size: 26rpx;
}

/* ================= 工具条 ================= */
.tools {
  display: flex;
  margin: 6rpx 4rpx 14rpx;
  align-items: center;
  justify-content: flex-end;
  justify-content: space-between;
}

.tools-text {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  color: #6b6559;
  font-size: 21rpx;
}

.tools-btn {
  color: #9a6b1f;
  font-size: 22rpx;
}

.tools-acts {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tools-share {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #9a6b1f;
  font-size: 22rpx;
  line-height: 1.4;
}
.tools-share::after { border: none; }

/* ================= 多选分享 ================= */
.hcard.picked { outline: 3rpx solid #9a6b1f; outline-offset: -3rpx; background: #fdf8ec; }
.pick-mark {
  position: absolute; z-index: 6; top: 14rpx; right: 14rpx;
  width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center;
  border-radius: 50%; border: 2rpx solid #c9bca2; background: #fff;
  color: #fff; font-size: 26rpx; font-weight: 700;
}
.hcard.picked .pick-mark { background: #9a6b1f; border-color: #9a6b1f; }
.pick-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #e8e2d5;
  box-shadow: 0 -6rpx 24rpx rgba(60,44,20,.08);
}
.pick-all { color: #9a6b1f; font-size: 26rpx; }
.pick-count { color: #6a6252; font-size: 25rpx; margin-left: auto; }
.pick-go {
  padding: 14rpx 34rpx; border-radius: 999rpx;
  background: #9a6b1f; color: #fff; font-size: 26rpx; font-weight: 600;
}
.pick-go.off { background: #c9bca2; color: #4a4438; }
/* 批量栏是 position:fixed，不占文档流；不留占位会盖住最后一张卡片（约 59rpx） */
.pick-spacer { height: calc(120rpx + env(safe-area-inset-bottom)); }

/* ================= 分组 ================= */
.ghead {
  display: flex;
  margin-top: 10rpx;
  padding: 16rpx 6rpx;
  align-items: center;
  justify-content: space-between;
}

.ghead-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.gname {
  color: #2b2926;
  font-size: 27rpx;
  font-weight: 600;
}

.gprog {
  color: #6b6559;
  font-size: 20rpx;
}

.ghead-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.gsum {
  color: #9a6b1f;
  font-size: 23rpx;
}

.gchev {
  color: #8a8378;
  font-size: 22rpx;
}

.gwrap {
  padding-bottom: 8rpx;
}

.gbar {
  height: 6rpx;
  margin: 0 6rpx 14rpx;
  border-radius: 999rpx;
  background: #efeade;
  overflow: hidden;
}

.gbar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #b98f43, #d9b364);
}

/* ================= 藏品卡片 ================= */
/* 交互：点卡片看资料，点右侧「⋯」改账。不再有左滑和长按——
   账本页的高频动作是改数量/成本，藏在手势里既不可发现，
   横向滑动又会和页面上下滚动抢手势（实测误触率高）。 */
.hcard {
  position: relative;
  display: flex;
  margin-bottom: 16rpx;
  padding: 20rpx;
  align-items: center;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 3rpx 16rpx rgba(74, 55, 20, 0.06);
}

/* 编辑入口：视觉 38rpx 的「⋯」，热区 96rpx 且贴到卡片右边缘 */
.hc-more {
  flex: 0 0 auto;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  margin: 0 -12rpx 0 2rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #8a8378;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 1rpx;
}

.hc-fig {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  margin-right: 20rpx;
  flex: 0 0 auto;
}

.hc-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 14rpx;
  background: #f8f6f1;
}

.hc-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8378;
  font-size: 21rpx;
}

.hc-main {
  flex: 1;
  min-width: 0;
}

.hc-name {
  display: block;
  color: #2b2926;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hc-sub {
  display: block;
  margin-top: 8rpx;
  color: #6b6559;
  font-size: 21rpx;
}

.hc-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
  align-items: center;
  gap: 4rpx 8rpx;
  color: #6b6559;
  font-size: 20rpx;
}

.foot-hint {
  margin: 22rpx 0 8rpx;
  color: #8a8378;
  font-size: 20rpx;
  text-align: center;
}

/* ================= 访客 ================= */
.guest-card {
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
}

.guest-title {
  display: block;
  color: #2b2926;
  font-size: 30rpx;
  font-weight: 600;
}

.guest-sub {
  display: block;
  margin: 14rpx 0 28rpx;
  color: #6b6559;
  font-size: 23rpx;
}

.guest-btn {
  width: 320rpx;
  margin: 0 auto;
}

/* ================= 操作面板 ================= */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 20, 14, 0.45);
}

.sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  /* 上限 86vh：号码 textarea 是 auto-height + 不限制长度，不设上限内容会把 ✕ 和「保存」顶出屏幕 */
  max-height: 86vh;
  padding: 0 30rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

/* 中间可滚动区：min-height:0 是 flex 子项能真正收缩/滚动的必要条件 */
.sheet-scroll {
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
}

.sheet-head {
  display: flex;
  flex: 0 0 auto;
  padding: 26rpx 0 18rpx;
  align-items: center;
  gap: 16rpx;
}

.sheet-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  flex: 0 0 auto;
}

.sheet-info {
  flex: 1;
  min-width: 0;
}

.sheet-name {
  display: block;
  color: #2b2926;
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet-sub {
  display: block;
  margin-top: 6rpx;
  color: #6b6559;
  font-size: 21rpx;
}

.sheet-link {
  padding: 0 12rpx 0 4rpx;
  color: #8a6420;
  font-size: 22rpx;
  line-height: 44rpx;
}

.sheet-x {
  position: relative;
  padding: 0 8rpx;
  color: #6b6559;
  font-size: 26rpx;
}

/* 关闭按钮热区：只扩可点范围，✕ 的位置和字号都不动 */
.sheet-x::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  margin: -44rpx 0 0 -44rpx;
}

.sheet-row {
  display: flex;
  padding: 20rpx 0;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f6f3ec;
}

.sr-k {
  color: #4a4438;
  font-size: 25rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #f7f4ed;
}

.step {
  position: relative;
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  color: #9a6b1f;
  font-size: 30rpx;
  box-shadow: 0 1rpx 4rpx rgba(74, 55, 20, 0.08);
}

.step-num {
  min-width: 110rpx;
  color: #2b2926;
  font-size: 25rpx;
  text-align: center;
}

.sr-input {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #f7f4ed;
}

.sr-cur {
  color: #9a6b1f;
  font-size: 24rpx;
}

.sr-field {
  width: 160rpx;
  color: #2b2926;
  font-size: 26rpx;
  text-align: right;
}

.ph {
  color: #8a8378;
}

.sheet-tip {
  display: block;
  margin-top: 10rpx;
  color: #6b6559;
  font-size: 20rpx;
}

.sheet-acts {
  display: flex;
  flex: 0 0 auto;
  margin-top: 8rpx;
  padding-top: 18rpx;
  gap: 18rpx;
  border-top: 1rpx solid #f6f3ec;
}

.act {
  flex: 1;
  height: 86rpx;
  margin: 0;
  line-height: 86rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
}

.act.ghost {
  border: 1rpx solid #f0d5d1;
  background: #fdf2f0;
  color: #9c5850;
}

.act.primary {
  background: linear-gradient(135deg, #b98f43, #d9b364);
  color: #ffffff;
  font-weight: 600;
}

.act::after {
  border: none;
}

.foot-note {
  margin-top: 16rpx;
  color: #9c5850;
  font-size: 21rpx;
  text-align: center;
}

/* 卡片里「成本 · 推理价」合并成一行：原来推理价单独占一行，
   把卡片撑到 4 行高，同屏能看到的藏品少了一半 */
.hc-sep {
  color: #8a8378;
}

/* 藏品品类筛选 */
.hold-cats{display:flex;gap:12rpx;padding:16rpx 0 20rpx}
.hc{
  position:relative;
  padding:9rpx 26rpx;border-radius:999rpx;border:1rpx solid #e6e0d4;
  background:#fff;color:#6b6559;font-size:24rpx
}
.hc.on{background:#fbf1d8;border-color:#d9bd82;color:#9a6b1f;font-weight:600}

/* 藏品增强：号码 / 花样 / 形态 / 图片（统一浅色主题，勿用深色 CSS 变量） */
.ex-row{align-items:flex-start;padding-top:20rpx}
.sr-textarea{
  flex:1;min-height:56rpx;line-height:1.5;font-size:26rpx;
  padding:12rpx 16rpx;border-radius:12rpx;background:#f7f4ed;
  border:1rpx solid #ece6d9;color:#2b2926;box-sizing:border-box
}
.sr-tags{display:flex;flex-wrap:wrap;gap:8rpx}
.sr-tag{font-size:20rpx;padding:4rpx 14rpx;border-radius:999rpx;background:#f6efe0;color:#6b5f45}
.sr-tag.rar2{color:#8a6420;background:#fbf2dd}
.sr-tag.rar3{color:#436b8a;background:#edf3f7}
.sr-tag.rar4{color:#6f5329;background:#f6efe0}
.sr-tag.rar5{color:#b4553f;background:#f8ece7}
.sr-segs{display:flex;gap:12rpx}
.sr-seg{
  position:relative;
  font-size:24rpx;padding:8rpx 26rpx;border-radius:999rpx;
  border:1rpx solid #e6e0d4;color:#6b6559;background:#fff
}
.sr-seg.on{color:#9a6b1f;border-color:#d9bd82;background:#fbf1d8;font-weight:600}
.sr-imgs{display:flex;flex-wrap:wrap;gap:12rpx}
.sr-img,.sr-img-add{position:relative;width:92rpx;height:92rpx;border-radius:12rpx;overflow:visible}
.sr-img image{width:92rpx;height:92rpx;border-radius:12rpx}
.sr-img-x{
  position:absolute;top:-10rpx;right:-10rpx;width:32rpx;height:32rpx;line-height:28rpx;text-align:center;
  border-radius:50%;background:#4a4438;border:1rpx solid #fff;color:#fff;font-size:24rpx
}
.sr-img-add{
  display:flex;align-items:center;justify-content:center;font-size:40rpx;
  border:1rpx dashed #d9cfba;color:#6b6559;background:#faf8f3
}

/* 高频操作热区 ≥44px（88rpx）—— 只扩可点区域，视觉尺寸一律不动。
   之前这里写成 .hc{min-height:72rpx;line-height:44rpx}、.step{width/height:88rpx} 之类，
   虽然注释写着「视觉尺寸不变」，实际把品类胶囊拉胖、把步进器 56rpx 的圆撑成 88rpx、
   把缩略图删除角标从 32rpx 放大一倍，整页看起来就是错版的。 */
.tools-btn,
.tools-share {
  /* 上下 padding 撑出 88rpx 热区，负 margin 抵消占位；横向只留 6rpx，免得把右侧挤爆 */
  padding: 24rpx 6rpx;
  margin: -24rpx 0;
}
.hc::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  margin-top: -44rpx;
}
.step::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  margin: -44rpx 0 0 -44rpx;
}
.sr-seg::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  margin-top: -44rpx;
}
.sr-img-x::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 64rpx;
  height: 64rpx;
  margin: -32rpx 0 0 -32rpx;
}
