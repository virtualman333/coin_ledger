/* ================= 顶部汇总 ================= */
.hero {
  position: relative;
  margin-bottom: 18rpx;
  padding: 30rpx 30rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #b98f43 0%, #d9b364 58%, #e3c489 100%);
  box-shadow: 0 12rpx 30rpx rgba(185, 143, 67, 0.25);
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-left {
  flex: 1;
  min-width: 0;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-k {
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
}

.hero-val {
  display: flex;
  margin-top: 8rpx;
  align-items: baseline;
  color: #ffffff;
}

.hv-cur {
  font-size: 26rpx;
}

.hv-num {
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.5rpx;
}

.hero-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  padding-top: 4rpx;
}

.hero-item {
  color: rgba(255, 255, 255, 0.86);
  font-size: 21rpx;
}

.hero-bottom {
  display: flex;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.24);
}

.hero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hc-k {
  color: rgba(255, 255, 255, 0.75);
  font-size: 20rpx;
}

.hc-v {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.hc-v.up {
  color: #fff6d8;
}

.hc-v.down {
  color: #e9f7e9;
}

.hc-pct {
  font-size: 20rpx;
  font-weight: 400;
}

/* ================= 空态 ================= */
.empty-card {
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  display: block;
  color: #2b2926;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-sub {
  display: block;
  margin: 14rpx 0 28rpx;
  color: #b3aa9b;
  font-size: 23rpx;
  line-height: 1.7;
}

.empty-btn {
  display: inline-block;
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #b98f43, #d9b364);
  color: #ffffff;
  font-size: 26rpx;
}

/* ================= 工具条 ================= */
.tools {
  display: flex;
  margin: 6rpx 4rpx 14rpx;
  align-items: center;
  justify-content: space-between;
}

.tools-text {
  color: #b3aa9b;
  font-size: 21rpx;
}

.tools-btn {
  color: #9a6b1f;
  font-size: 22rpx;
}

/* ================= 分组 ================= */
.ghead {
  display: flex;
  margin-top: 10rpx;
  padding: 16rpx 6rpx;
  align-items: center;
  justify-content: space-between;
}

.ghead-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.gname {
  color: #2b2926;
  font-size: 27rpx;
  font-weight: 600;
}

.gprog {
  color: #b3aa9b;
  font-size: 20rpx;
}

.ghead-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.gsum {
  color: #9a6b1f;
  font-size: 23rpx;
}

.gchev {
  color: #c3bbad;
  font-size: 22rpx;
}

.gwrap {
  padding-bottom: 8rpx;
}

.gbar {
  height: 6rpx;
  margin: 0 6rpx 14rpx;
  border-radius: 999rpx;
  background: #efeade;
  overflow: hidden;
}

.gbar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #b98f43, #d9b364);
}

/* ================= 藏品卡片 ================= */
/* 左滑：卡片左移，右侧露出「改成本 / 改数量」 */
.hswipe {
  position: relative;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.hswipe .hcard {
  position: relative;
  z-index: 2;
  margin-bottom: 0;
  transition: transform 0.22s ease;
}

.hswipe .hcard.swiped {
  transform: translateX(-200rpx);
}

.hswipe-acts {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  z-index: 1;
}

.hs-act {
  width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.3;
}

.hs-cost { background: #b98f43; }
.hs-qty { background: #6b6459; }

.hcard {
  display: flex;
  margin-bottom: 16rpx;
  padding: 20rpx;
  align-items: center;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 3rpx 16rpx rgba(74, 55, 20, 0.06);
}

.hc-fig {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  margin-right: 20rpx;
  flex: 0 0 auto;
}

.hc-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 14rpx;
  background: #f8f6f1;
}

.hc-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c3bbad;
  font-size: 21rpx;
}

.hc-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: #2b2926;
  color: #f6e7c6;
  font-size: 18rpx;
  line-height: 1.5;
}

.hc-main {
  flex: 1;
  min-width: 0;
}

.hc-name {
  display: block;
  color: #2b2926;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hc-sub {
  display: block;
  margin-top: 8rpx;
  color: #b3aa9b;
  font-size: 21rpx;
}

.hc-meta {
  display: flex;
  margin-top: 10rpx;
  align-items: center;
  gap: 8rpx;
  color: #8a8378;
  font-size: 20rpx;
}

.hc-dot {
  color: #d6cebe;
}

.hc-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  margin-left: 14rpx;
  flex: 0 0 auto;
}

.hc-val {
  color: #2b2926;
  font-size: 30rpx;
  font-weight: 700;
}

.hc-pnl {
  font-size: 20rpx;
}

.hc-pnl.up {
  color: #b5766c;
}

.hc-pnl.down {
  color: #4f8a5f;
}

.foot-hint {
  margin: 22rpx 0 8rpx;
  color: #c3bbad;
  font-size: 20rpx;
  text-align: center;
}

/* ================= 访客 ================= */
.guest-card {
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
}

.guest-title {
  display: block;
  color: #2b2926;
  font-size: 30rpx;
  font-weight: 600;
}

.guest-sub {
  display: block;
  margin: 14rpx 0 28rpx;
  color: #b3aa9b;
  font-size: 23rpx;
}

.guest-btn {
  width: 320rpx;
  margin: 0 auto;
}

/* ================= 操作面板 ================= */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 20, 14, 0.45);
}

.sheet {
  width: 100%;
  padding: 0 30rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  padding: 26rpx 0 18rpx;
  align-items: center;
  gap: 16rpx;
}

.sheet-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #f8f6f1;
  flex: 0 0 auto;
}

.sheet-info {
  flex: 1;
  min-width: 0;
}

.sheet-name {
  display: block;
  color: #2b2926;
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet-sub {
  display: block;
  margin-top: 6rpx;
  color: #b3aa9b;
  font-size: 21rpx;
}

.sheet-x {
  padding: 0 8rpx;
  color: #b3aa9b;
  font-size: 26rpx;
}

.sheet-row {
  display: flex;
  padding: 20rpx 0;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f6f3ec;
}

.sr-k {
  color: #4a4438;
  font-size: 25rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #f7f4ed;
}

.step {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  color: #9a6b1f;
  font-size: 30rpx;
  box-shadow: 0 1rpx 4rpx rgba(74, 55, 20, 0.08);
}

.step-num {
  min-width: 110rpx;
  color: #2b2926;
  font-size: 25rpx;
  text-align: center;
}

.sr-input {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #f7f4ed;
}

.sr-cur {
  color: #9a6b1f;
  font-size: 24rpx;
}

.sr-field {
  width: 160rpx;
  color: #2b2926;
  font-size: 26rpx;
  text-align: right;
}

.ph {
  color: #c3bbad;
}

.sheet-tip {
  display: block;
  margin-top: 10rpx;
  color: #b3aa9b;
  font-size: 20rpx;
}

.sheet-acts {
  display: flex;
  margin-top: 26rpx;
  gap: 18rpx;
}

.act {
  flex: 1;
  height: 86rpx;
  margin: 0;
  line-height: 86rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
}

.act.ghost {
  border: 1rpx solid #f0d5d1;
  background: #fdf2f0;
  color: #b5766c;
}

.act.primary {
  background: linear-gradient(135deg, #b98f43, #d9b364);
  color: #ffffff;
  font-weight: 600;
}

.act::after {
  border: none;
}

.foot-note {
  margin-top: 16rpx;
  color: #b5766c;
  font-size: 21rpx;
  text-align: center;
}

/* 卡片里的 AI 推理价 */
.hc-ai {
  display: flex;
  margin-top: 8rpx;
  align-items: center;
  gap: 8rpx;
}

.hc-ai-badge {
  /* 不用色块：小尺寸下深底容易糊成一团，改金色小字更干净 */
  padding: 0 2rpx 0 0;
  color: #b98f43;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.hc-ai-val {
  color: #9a6b1f;
  font-size: 21rpx;
  font-weight: 600;
}

.hc-ai-d {
  color: #b3aa9b;
  font-size: 19rpx;
}

/* 藏品品类筛选 */
.hold-cats{display:flex;gap:12rpx;padding:16rpx 0 20rpx}
.hc{
  padding:9rpx 26rpx;border-radius:999rpx;border:1rpx solid #e6e0d4;
  background:#fff;color:#7d766b;font-size:24rpx
}
.hc.on{background:#fbf1d8;border-color:#d9bd82;color:#9a6b1f;font-weight:600}
