@import "../admin/admin-common.wxss";

/* 用户管理：统计一句话 + 搜索 + 状态筛选 + 列表 */

.sum {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin: 0 4rpx 16rpx;
  color: #6b6559;
  font-size: 22rpx;
}

.sum-s {
  color: #8a8378;
}

.search {
  display: flex;
  height: 80rpx;
  padding: 0 20rpx;
  align-items: center;
  gap: 10rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(74, 55, 20, 0.05);
}

.s-ico {
  color: #8a8378;
  font-size: 28rpx;
  flex: 0 0 auto;
}

.s-input {
  flex: 1;
  min-width: 0;
  color: #2b2926;
  font-size: 26rpx;
}

.s-ph {
  color: #8a8378;
}

.s-clear {
  padding: 0 4rpx;
  color: #8a8378;
  font-size: 24rpx;
  flex: 0 0 auto;
}

.chips {
  display: flex;
  margin: 18rpx 0 18rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.chip {
  padding: 10rpx 24rpx;
  border: 1rpx solid #e6e0d4;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b6559;
  font-size: 23rpx;
}

.chip.on {
  border-color: #d9bd82;
  background: #fbf1d8;
  color: #9a6b1f;
  font-weight: 600;
}

.user-row {
  align-items: center;
  gap: 16rpx;
}

.uava {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f2efe7;
  color: #6b6559;
  font-size: 28rpx;
  font-weight: 600;
  flex: 0 0 auto;
}

.uava.adm {
  background: #f6efe0;
  color: #8a6420;
}

.uava.off {
  opacity: 0.55;
}

.badge.test {
  background: #f3f0e9;
  color: #6b6559;
}

.badge.off {
  background: #fbeeec;
  color: #9c5850;
}

.more {
  padding: 28rpx 0 8rpx;
  color: #8a8378;
  font-size: 22rpx;
  text-align: center;
}

.empty {
  padding: 80rpx 0;
  color: #8a8378;
  font-size: 24rpx;
  text-align: center;
}

/* 真头像：和字母头像同一个圆形尺寸，别让列表行高跳动 */
.uava-img {
  background: #f2efe7;
}

/* 账号名单独一行，和昵称/徽标拉开层次（昵称可能和账号名完全不同） */
.r-sub2 {
  color: #8a8378;
  font-size: 21rpx;
}

.badge.wx {
  background: #eaf4ea;
  color: #4a7a4a;
}

/* 登录方式：密钥（账号密码）/ 华为账号；微信见上 */
.badge.pw {
  background: #eef1f5;
  color: #5b6a78;
}

.badge.hw {
  background: #fbeeec;
  color: #a3281c;
}
