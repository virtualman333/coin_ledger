<view class="page">
  <text class="grp">工具</text>
  <view class="group">
    <view class="cell" hover-class="row-hover" hover-stay-time="80" bindtap="onBackup" aria-role="button" aria-label="收藏备份">
      <view class="cell-ico"><text>⇅</text></view>
      <text class="cell-k">收藏备份</text>
      <text class="cell-a">›</text>
    </view>
    <view class="cell" hover-class="row-hover" hover-stay-time="80" bindtap="goCount" aria-role="button" aria-label="拍照数币">
      <view class="cell-ico"><text>◎</text></view>
      <text class="cell-k">拍照数币</text>
      <text class="cell-a">›</text>
    </view>
  </view>

  <text class="grp">其他</text>
  <view class="group">
    <view class="cell" hover-class="row-hover" hover-stay-time="80" bindtap="goMyFeedback" aria-role="button" aria-label="我的反馈">
      <view class="cell-ico"><text>✎</text></view>
      <text class="cell-k">我的反馈</text>
      <text class="cell-a">›</text>
    </view>
    <view class="cell" hover-class="row-hover" hover-stay-time="80" bindtap="goAbout" aria-role="button" aria-label="关于藏币录">
      <view class="cell-ico"><text>❖</text></view>
      <text class="cell-k">关于藏币录</text>
      <text class="cell-v">v{{appVersion}}</text>
      <text class="cell-a">›</text>
    </view>
  </view>

  <block wx:if="{{loggedIn}}">
    <text class="grp">账号</text>
    <view class="group">
      <view class="cell" hover-class="row-hover" hover-stay-time="80" bindtap="onLogout" aria-role="button" aria-label="退出登录">
        <view class="cell-ico"><text>⏻</text></view>
        <text class="cell-k cell-danger">退出登录</text>
        <text class="cell-a">›</text>
      </view>
    </view>
  </block>

  <block wx:if="{{isAdmin}}">
    <text class="grp">管理</text>
    <view class="group">
      <view class="cell" hover-class="row-hover" hover-stay-time="80" bindtap="goAdmin" aria-role="button" aria-label="管理端">
        <view class="cell-ico"><text>⚙</text></view>
        <text class="cell-k">管理端</text>
        <text class="cell-a">›</text>
      </view>
    </view>
  </block>
</view>
