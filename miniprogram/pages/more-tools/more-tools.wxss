/* 更多功能：分组卡片 + 图标行 */

.tip {
  margin: 4rpx 6rpx 24rpx;
  color: #6b6559;
  font-size: 22rpx;
  line-height: 1.6;
}

.grp {
  margin-bottom: 28rpx;
}

.grp-t {
  display: block;
  margin: 0 10rpx 12rpx;
  color: #6b6559;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.grp-card {
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 14rpx rgba(74, 55, 20, 0.05);
  overflow: hidden;
}

.tool-row {
  display: flex;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #f6f3ec;
}

.tool-row:last-child {
  border-bottom: none;
}

.ico {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  flex: 0 0 auto;
}

.ico-gold { background: #f6efe0; color: #8a6420; }
.ico-blue { background: #edf2f7; color: #3e5c76; }
.ico-green { background: #eaf6ee; color: #3f7a55; }
.ico-grey { background: #f2efe7; color: #6b6559; }
.ico-red { background: #fbeeec; color: #9c5850; }

.tool-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tool-k {
  color: #2b2926;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.tool-v {
  margin-top: 4rpx;
  color: #6b6559;
  font-size: 21rpx;
}

.tool-arrow {
  color: #6b6559;
  font-size: 34rpx;
  line-height: 1;
  flex: 0 0 auto;
}
