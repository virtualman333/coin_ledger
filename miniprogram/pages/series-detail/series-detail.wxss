.page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #f6f4ef;
}

/* 系列封面 hero */
.hero {
  position: relative;
  min-height: 360rpx;
  padding: 40rpx 32rpx 36rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(135deg, #3a3328, #6b5836);
}
.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: blur(2rpx);
  opacity: .55;
}
.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(28,24,18,.30) 0%, rgba(28,24,18,.78) 100%);
}
.hero-inner { position: relative; z-index: 1; }
.hero-name {
  display: block;
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,.35);
}
.hero-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(255,255,255,.82);
  font-size: 23rpx;
  line-height: 1.6;
}
.hero-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.hero-tag {
  padding: 5rpx 16rpx;
  border: 1rpx solid rgba(233,200,119,.5);
  border-radius: 999rpx;
  color: #e9c877;
  font-size: 20rpx;
}
.hero-progress { display: flex; margin-top: 26rpx; align-items: center; gap: 16rpx; }
.hp-bar {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.22);
  overflow: hidden;
}
.hp-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #d9b364, #f0d79a); }
.hp-text { color: rgba(255,255,255,.9); font-size: 21rpx; white-space: nowrap; }
.hero-stat { display: flex; margin-top: 20rpx; align-items: baseline; }
.hs-num { color: #fff; font-size: 30rpx; font-weight: 700; }
.hs-unit { margin-left: 6rpx; color: rgba(255,255,255,.7); font-size: 21rpx; }
.hs-price { margin-left: auto; color: #e9c877; font-size: 21rpx; }

/* 工具行 */
.tools {
  display: flex;
  padding: 20rpx 24rpx 4rpx;
  gap: 14rpx;
  align-items: center;
}
.tool {
  padding: 12rpx 26rpx;
  border: 1rpx solid #e6e0d4;
  border-radius: 999rpx;
  background: #fff;
  color: #7d766b;
  font-size: 23rpx;
  line-height: 1.2;
}
.tool.on { border-color: #d9bd82; background: #fbf1d8; color: #9a6b1f; font-weight: 600; }
.share-tool {
  margin-left: auto;
  border-color: #d9bd82;
  background: #9a6b1f;
  color: #fff;
  font-size: 23rpx;
}
.share-tool::after { border: none; }

/* 品种列表 */
.list { padding: 12rpx 24rpx 0; }
.row {
  display: flex;
  margin-bottom: 18rpx;
  padding: 18rpx;
  align-items: center;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(74,55,20,.06);
}
.row-media { position: relative; flex-shrink: 0; width: 120rpx; height: 120rpx; }
.row-img { display: block; width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #faf8f3; }
.row-ph {
  display: flex;
  width: 120rpx;
  height: 120rpx;
  padding: 0 10rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f6efe0;
  box-sizing: border-box;
}
.row-ph text { color: #b08a3e; font-size: 19rpx; text-align: center; line-height: 1.4; }
.own-dot {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 2rpx 10rpx;
  border-radius: 0 8rpx 0 10rpx;
  background: rgba(154,107,31,.9);
  color: #fff;
  font-size: 17rpx;
}
.row-body { flex: 1; min-width: 0; margin-left: 20rpx; }
.row-name {
  display: block;
  color: #2b2926;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.row-meta { display: block; margin-top: 8rpx; color: #8a8378; font-size: 21rpx; }
.row-sub { display: block; margin-top: 4rpx; color: #b3aa9b; font-size: 19rpx; }
.row-right { flex-shrink: 0; margin-left: 14rpx; text-align: right; }
.row-price { display: block; color: #9a6b1f; font-size: 23rpx; font-weight: 600; }
.row-arrow { display: block; margin-top: 8rpx; color: #c3b9a5; font-size: 30rpx; line-height: 1; }

/* 状态 */
.state { padding: 120rpx 40rpx; color: #b3aa9b; font-size: 24rpx; text-align: center; }
.more { padding: 20rpx 0 40rpx; color: #b3aa9b; font-size: 21rpx; text-align: center; }
