<view class="page">
  <!-- 概览：三个数字都能点，直达对应模块 -->
  <view class="stats">
    <view class="stat" data-k="users" bindtap="statTap" hover-class="stat-hover" hover-stay-time="80" aria-role="button" aria-label="进入用户管理">
      <text class="s-num">{{userCount}}</text>
      <text class="s-k">用户</text>
    </view>
    <view class="stat" data-k="params" bindtap="statTap" hover-class="stat-hover" hover-stay-time="80" aria-role="button" aria-label="进入参数管理">
      <text class="s-num">{{coinCount}}</text>
      <text class="s-k">品种</text>
    </view>
    <view class="stat" data-k="feedback" bindtap="statTap" hover-class="stat-hover" hover-stay-time="80" aria-role="button" aria-label="进入反馈处理">
      <text class="s-num {{openCount ? 'warn' : ''}}">{{openCount}}</text>
      <text class="s-k">待处理反馈</text>
    </view>
  </view>

  <!-- 管理首页：原生式分组列表，点进去是真实的三级页面 -->
  <block wx:for="{{modules}}" wx:key="group" wx:for-item="grp">
    <view class="mgroup">
      <view class="mgroup-t">{{grp.group}}</view>
      <view class="mgroup-card {{grp.cls}}">
        <view
          class="mrow"
          wx:for="{{grp.items}}"
          wx:key="k"
          data-k="{{item.k}}"
          bindtap="goModule"
          hover-class="mrow-hover"
          hover-stay-time="80"
          aria-role="button"
          aria-label="{{item.t}}"
        >
          <view class="mi"><text class="mi-g">{{item.i}}</text></view>
          <view class="mtext">
            <view class="mt-line">
              <text class="mt">{{item.t}}</text>
              <text class="mbadge" wx:if="{{item.k === 'feedback' && openCount}}">{{openCount}}</text>
            </view>
            <text class="md">{{item.d}}</text>
          </view>
          <text class="mgo">›</text>
        </view>
      </view>
    </view>
  </block>

  <view class="foot-tip">与网页版管理端共用同一套数据</view>
</view>
