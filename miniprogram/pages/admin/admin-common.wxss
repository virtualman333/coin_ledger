.page {
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

/* 概览：三格可点，按压有底色反馈 */
.stats {
  display: flex;
  margin-bottom: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 14rpx rgba(74, 55, 20, 0.05);
  overflow: hidden;
}

.stat {
  flex: 1;
  display: flex;
  padding: 30rpx 0 26rpx;
  align-items: center;
  flex-direction: column;
  transition: background-color 0.15s ease;
}

.stat-hover {
  background: #faf6ec;
}

.stat + .stat {
  border-left: 1rpx solid #f2efe7;
}

.s-num {
  color: #2b2926;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.1;
}

.s-num.warn {
  color: #9c5850;
}

.s-k {
  margin-top: 8rpx;
  color: #6b6559;
  font-size: 21rpx;
}

/* 页签 */
.tabs {
  display: flex;
  margin-bottom: 16rpx;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.tab {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 10rpx;
  color: #6b6559;
  font-size: 25rpx;
  text-align: center;
}

.tab.on {
  background: #f6efe0;
  color: #8a6420;
  font-weight: 600;
}

/* 列表 */
.list {
  padding: 0 26rpx;
}

.row {
  display: flex;
  padding: 24rpx 0;
  align-items: center;
  border-bottom: 1rpx solid #f6f3ec;
}

.row:last-child {
  border-bottom: none;
}

.r-main {
  flex: 1;
  min-width: 0;
}

.r-title {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx 12rpx;
  color: #2b2926;
  font-size: 27rpx;
  font-weight: 600;
}

.r-title-text {
  color: #2b2926;
  font-size: 26rpx;
  font-weight: 600;
}

.r-sub {
  display: block;
  margin-top: 8rpx;
  color: #6b6559;
  font-size: 21rpx;
}

.r-text {
  display: block;
  margin-top: 8rpx;
  color: #4a4438;
  font-size: 24rpx;
  line-height: 1.6;
}

.row.fb {
  align-items: flex-start;
}

.r-more {
  margin-left: 12rpx;
  color: #6b6559;
  font-size: 30rpx;
}

.r-thumb {
  width: 88rpx;
  height: 88rpx;
  margin-right: 18rpx;
  border-radius: 12rpx;
  background: #f6f4ef;
}

.badge {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #f2efe7;
  color: #6b6559;
  font-size: 21rpx;
  font-weight: 400;
}

.badge.admin {
  background: #f6efe0;
  color: #8a6420;
}

.badge.warn {
  background: #fbeeec;
  color: #9c5850;
}

/* 搜索 */
.search {
  display: flex;
  margin-bottom: 16rpx;
  padding: 0 24rpx;
  align-items: center;
  border-radius: 14rpx;
  background: #ffffff;
  height: 78rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-clear {
  position: relative;
  padding: 0 8rpx;
  color: #6b6559;
  font-size: 24rpx;
}
/* 清空按钮的 ✕ 只有 ~34rpx，热区补到 88rpx */
.search-clear::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  margin: -44rpx 0 0 -44rpx;
}

.ph {
  color: #8a8378;
}

/* 图片网格 */
.tip {
  margin: 0 4rpx 14rpx;
  color: #6b6559;
  font-size: 21rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.gitem {
  width: 31.5%;
  margin: 0 2.75% 22rpx 0;
  text-align: center;
}

.gitem:nth-child(3n) {
  margin-right: 0;
}

.gimg {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.gname {
  display: block;
  margin-top: 8rpx;
  color: #4a4438;
  font-size: 20rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gno {
  color: #6b6559;
  font-size: 21rpx;
}

/* 反馈 */
.filters {
  display: flex;
  margin-bottom: 14rpx;
  gap: 12rpx;
}

.fchip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b6559;
  font-size: 22rpx;
}

.fchip.on {
  background: #f6efe0;
  color: #8a6420;
}

.empty {
  padding: 60rpx 0;
  color: #6b6559;
  font-size: 24rpx;
  text-align: center;
}

.foot-tip {
  margin-top: 24rpx;
  color: #6b6559;
  font-size: 20rpx;
  text-align: center;
}

/* 弹层 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 20, 14, 0.45);
}

.sheet {
  width: 100%;
  max-height: 84vh;
  padding: 0 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  padding: 28rpx 0 18rpx;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  color: #2b2926;
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-x {
  position: relative;
  padding: 0 10rpx;
  color: #6b6559;
  font-size: 28rpx;
}
.sheet-x::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  margin: -44rpx 0 0 -44rpx;
}

/* admin.wxml 用到了 .loading，但本页与 app.wxss 都没定义，之前是完全没样式的裸文本 */
.loading {
  padding: 60rpx 0;
  color: #6b6559;
  font-size: 26rpx;
  text-align: center;
}

.field {
  display: flex;
  padding: 16rpx 0;
  align-items: center;
  border-bottom: 1rpx solid #f6f3ec;
}

.f-label {
  width: 220rpx;
  color: #6b6559;
  font-size: 24rpx;
}

.f-input {
  flex: 1;
  font-size: 26rpx;
  text-align: right;
}

.btn-primary {
  margin-top: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #b98f43, #d9b364);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.fb-text {
  display: block;
  color: #2b2926;
  font-size: 26rpx;
  line-height: 1.75;
}

.fb-img {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 12rpx;
}

.fb-meta {
  display: block;
  margin-top: 16rpx;
  color: #6b6559;
  font-size: 21rpx;
}

.fb-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 26rpx;
  gap: 18rpx;
}

.half {
  flex: 1;
  /* .btn-primary 自带 margin-top:30rpx，在 .fb-actions 的横排里会把第一个按钮顶下去 */
  margin-top: 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.btn-ghost {
  border: 1rpx solid #e6dfd0;
  background: #ffffff;
  color: #6b6559;
}

.btn-danger {
  border: 1rpx solid #f0d5d1;
  background: #fdf2f0;
  color: #9c5850;
}

.btn-primary::after,
.btn-ghost::after,
.btn-danger::after {
  border: none;
}

.badge.test {
  background: #eaf6ee;
  color: #3f7a55;
}

.new-btn {
  /* .btn-primary 自带 margin-top:30rpx，紧跟模块标题时会多出一大截空白 */
  margin-top: 0;
  margin-bottom: 16rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
}

.ph2 {
  background: #f6efe0;
}

.series-ops {
  display: flex;
  margin-top: 22rpx;
  gap: 18rpx;
}

/* 管理首页：功能入口卡片 */
/* 分组：一张卡装一组行，行高 112rpx，点按整行 */
.mgroup { margin-bottom: 36rpx; }
.mgroup-t {
  margin: 0 12rpx 12rpx;
  color: #6b6559;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.mgroup-card {
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 14rpx rgba(74, 55, 20, 0.05);
  overflow: hidden;
}
.mrow {
  display: flex;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #f6f3ec;
  transition: background-color 0.15s ease;
}
.mrow:last-child { border-bottom: none; }
.mrow-hover { background: #faf6ec; }
.mi {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  flex: 0 0 auto;
}
.mi-g { font-size: 30rpx; line-height: 1; }
.g-content .mi { background: #f6efe0; color: #8a6420; }
.g-ops .mi { background: #fbeeec; color: #9c5850; }
.g-data .mi { background: #edf2f7; color: #3e5c76; }
.mtext { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.mt-line { display: flex; align-items: center; gap: 12rpx; }
.mt { min-width: 0; color: #2b2926; font-size: 28rpx; font-weight: 600; line-height: 1.3; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mbadge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #9c5850;
  color: #ffffff;
  font-size: 21rpx;
  line-height: 32rpx;
  text-align: center;
}
.md { margin-top: 4rpx; color: #6b6559; font-size: 21rpx; }
.mgo { color: #6b6559; font-size: 34rpx; line-height: 1; }

/* 模块页顶部 */
.mod-head {
  display: flex;
  margin-bottom: 20rpx;
  padding: 2rpx 4rpx;
  align-items: center;
  gap: 18rpx;
}
.mod-back {
  position: relative;
  display: flex;
  height: 56rpx;
  padding: 0 20rpx 0 14rpx;
  align-items: center;
  border: 1rpx solid #eee9df;
  border-radius: 999rpx;
  background: #ffffff;
  color: #8a6420;
  font-size: 23rpx;
}
/* 返回键只有 56rpx 高，补一层 88rpx 的透明热区 */
.mod-back::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  margin-top: -44rpx;
}
.mod-name { color: #2b2926; font-size: 30rpx; font-weight: 600; }

/* 访客统计 */
.vs-bar { display: flex; margin-bottom: 10rpx; padding: 6rpx 0; align-items: center; gap: 10rpx; }
.vchip {
  position: relative;
  padding: 9rpx 20rpx;
  border: 1rpx solid #e6dfd0;
  border-radius: 999rpx;
  color: #6b6559;
  font-size: 22rpx;
}
/* 一排筛选胶囊只有 ~49rpx 高，纵向补到 64rpx；横向不扩，免得相邻项抢点击。
   注意不能直接补到 88rpx：三行 .vs-bar 行距只有 14rpx，热区会互相重叠导致误触 */
.vchip::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 64rpx;
  margin-top: -32rpx;
}
.vchip.on { border-color: #8a6420; background: #9a6b1f; color: #ffffff; }
.vs-hint { margin-left: auto; color: #6b6559; font-size: 21rpx; }
.vs-cards { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 18rpx; }
.vsc {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border: 1rpx solid #eee9df;
  border-radius: 14rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.vsn { color: #8a6420; font-size: 32rpx; font-weight: 700; }
.vsk { color: #6b6559; font-size: 20rpx; }
.vr {
  display: flex;
  padding: 20rpx 0;
  align-items: center;
  border-bottom: 1rpx solid #f6f3ec;
}
.vr:last-child { border-bottom: none; }
.vr-main { flex: 1; min-width: 0; }
.vr-title { display: flex; flex-wrap: wrap; align-items: center; gap: 4rpx 8rpx; color: #2b2926; font-size: 25rpx; font-weight: 600; }
.vr-meta { display: block; margin-top: 8rpx; color: #6b6559; font-size: 20rpx; }
.vr-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; margin-left: 12rpx; }
.vr-time { color: #6b6559; font-size: 21rpx; }
.vr-ip { color: #6b6559; font-size: 20rpx; font-family: monospace; }
.vdev { color: #6b6559; font-size: 21rpx; font-weight: 400; }
.vsrc { padding: 1rpx 8rpx; border-radius: 6rpx; font-size: 21rpx; font-weight: 400; }
.vsrc.mp { background: #e7f7ee; color: #06793f; }
.vsrc.web { background: #eaf1fd; color: #1a63c9; }

/* 访客明细弹层 */
.vdd-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 140;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 20, 14, 0.45);
}
.vdd-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 82vh;
  /* 封住圆角与溢出；高度由内容决定，明细区的滚动交给 .vdd-list 自身的 max-height */
  overflow: hidden;
  padding: 0 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 26rpx 26rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}
.vdd-head {
  display: flex;
  flex: 0 0 auto;
  padding: 26rpx 0 12rpx;
  align-items: center;
  justify-content: space-between;
}
.vdd-title { color: #2b2926; font-size: 28rpx; font-weight: 600; }
.vdd-x {
  position: relative;
  color: #6b6559;
  font-size: 28rpx;
}
.vdd-x::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  margin: -44rpx 0 0 -44rpx;
}
.vdd-sub { display: block; flex: 0 0 auto; padding-bottom: 14rpx; color: #6b6559; font-size: 20rpx; }
/* 明细列表：内容少时按内容高度铺开，多时封顶 60vh 内部滚动。
   不能用 flex:1 1 0 —— 父级 .vdd-sheet 只有 max-height 没有确定 height，
   basis:0 的子项分不到高度会整块塌陷成 0（明细连同空状态一起看不见）。
   给 scroll-view 自身 max-height，既不塌陷、超出也能滚。 */
.vdd-list { max-height: 60vh; min-height: 0; }
.vdd-row {
  display: flex;
  padding: 16rpx 0;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid #f6f3ec;
  font-size: 21rpx;
}
.vdd-time { color: #6b6559; width: 190rpx; flex: 0 0 auto; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.vdd-tab { min-width: 0; color: #2b2926; font-weight: 600; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.vdd-src { font-size: 21rpx; }
/* 用户名（账号）在上、昵称在下：认账号靠用户名，认人靠昵称 */
.vdd-user {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
  max-width: 170rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}
.vdd-uname {
  color: #2b2926;
  font-size: 21rpx;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 170rpx;
}
.vdd-nick {
  color: #8a8378;
  font-size: 20rpx;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 170rpx;
}
.vdd-src.mp { color: #06793f; }
.vdd-src.web { color: #1a63c9; }
.vdd-user { color: #6b6559; width: 130rpx; text-align: right; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.vdd-foot {
  flex: 0 0 auto;
  margin-top: 18rpx;
  padding: 18rpx 0;
  border: 1rpx solid #e6dfd0;
  border-radius: 12rpx;
  color: #6b6559;
  font-size: 23rpx;
  text-align: center;
}

/* 访客加载失败：常驻提示，点一下重试 */
.vs-err{
  padding: 28rpx 20rpx;
  border: 1rpx solid #f0dede;
  border-radius: 14rpx;
  background: #fdf6f6;
  color: #9c5850;
  font-size: 22rpx;
  text-align: center;
}

/* 访客区间说明 */
.vs-note{
  display: block;
  margin: -6rpx 0 16rpx 4rpx;
  color: #6b6559;
  font-size: 20rpx;
}

/* 反馈回复 */
.fb-reply{
  width:100%;min-height:150rpx;box-sizing:border-box;
  margin:16rpx 0 8rpx;padding:18rpx;
  border:1rpx solid #e6e0d4;border-radius:14rpx;
  background:#fff;color:#2a2620;font-size:26rpx;line-height:1.6
}
.fb-prev-reply{
  margin:10rpx 0;padding:14rpx 18rpx;border-radius:12rpx;
  background:#fbf1d8;color:#8a6b34;font-size:24rpx;line-height:1.6
}

/* 大分类总览 */
.cat-card{margin:16rpx 0;padding:22rpx;border-radius:14rpx;background:#fff;border:1rpx solid #ece7dc}
.cc-top{display:flex;align-items:baseline;justify-content:space-between}
.cc-name{font-size:30rpx;font-weight:600;color:#2a2620}
.cc-count{font-size:26rpx;color:#8a6420;font-weight:600}
.cc-sub{margin-top:8rpx;font-size:22rpx;color:#6b6559}
.cc-bar{margin-top:12rpx;height:8rpx;border-radius:8rpx;background:#f3f0e9;overflow:hidden}
.cc-fill{height:100%;background:#d4af37}
/* 贵金属管理列表 */
.pm-search{display:flex;gap:12rpx;margin:16rpx 0;align-items:center}
.pm-search input{flex:1;height:72rpx;padding:0 18rpx;border-radius:12rpx;background:#fff;border:1rpx solid #ece7dc;font-size:25rpx;box-sizing:border-box}
.pm-search button{position:relative;padding:0 26rpx;height:72rpx;line-height:72rpx;font-size:24rpx;background:#9a6b1f;color:#fff;border-radius:12rpx}
/* 小程序 button 默认带一条 ::after 灰边框，棕色底上会显出一圈脏边 */
.pm-search button::after,
.pm-nav button::after{border:none}
/* 搜索/翻页按钮的点击热区补到 88rpx，视觉尺寸不变 */
.pm-search button::before,
.pm-nav button::before{
  content:'';position:absolute;top:50%;left:0;right:0;height:88rpx;margin-top:-44rpx;
}
.pm-total{font-size:22rpx;color:#6b6559;margin-bottom:10rpx}
.pm-row{display:flex;gap:14rpx;align-items:center;padding:14rpx;margin-bottom:10rpx;border-radius:12rpx;background:#fff;border:1rpx solid #ece7dc}
.pm-row image{width:96rpx;height:96rpx;border-radius:8rpx;background:#f3f0e9;flex:0 0 auto}
.pm-r-b{flex:1;min-width:0}
.pm-r-n{display:block;font-size:25rpx;color:#2a2620;line-height:1.5}
.pm-r-m{display:block;margin-top:6rpx;font-size:21rpx;color:#6b6559}
.pm-nav{display:flex;gap:16rpx;margin:20rpx 0}
.pm-nav button{position:relative;flex:1;font-size:25rpx;padding:16rpx 0;background:#fff;border:1rpx solid #ece7dc;border-radius:12rpx;color:#6b6559}
.pm-nav button[disabled]{color:#8a8378;background:#faf8f3}
