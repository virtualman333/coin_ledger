<!--
  唯一宿主页：四个内容视图全部常驻在这里，底部 TabBar 只渲染一次、永不重建。
  TabBar 不随页面切换，药丸的滑动就是一段连续动画。

  每个 tab 用 scroll-view 独立滚动，不再用页面级 enablePullDownRefresh：
  iOS 的下拉刷新会把整个 webview 往下推，position: fixed 的胶囊会被一起拖走 ——
  那就是"下拉时 tabBar 抖动"的来源。交给 scroll-view 自己做，页面不动，胶囊就不会动。
-->
<view class="shell">
  <view class="pane" hidden="{{tab !== 0}}">
    <scroll-view
      id="scroll-0"
      class="pane-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      refresher-enabled
      refresher-background="#f6f4ef"
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onLower"
    >
      <home-view id="view-home" bind:switchtab="onViewSwitch" bind:refreshed="onRefreshed"></home-view>
    </scroll-view>
  </view>

  <view class="pane" hidden="{{tab !== 1}}">
    <scroll-view
      id="scroll-1"
      class="pane-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      refresher-enabled
      refresher-background="#f6f4ef"
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onLower"
    >
      <plan-view id="view-plan" bind:switchtab="onViewSwitch" bind:refreshed="onRefreshed"></plan-view>
    </scroll-view>
  </view>

  <view class="pane" hidden="{{tab !== 2}}">
    <scroll-view
      id="scroll-2"
      class="pane-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      refresher-enabled
      refresher-background="#f6f4ef"
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onLower"
    >
      <list-view id="view-list" bind:switchtab="onViewSwitch" bind:refreshed="onRefreshed"></list-view>
    </scroll-view>
  </view>

  <view class="pane" hidden="{{tab !== 3}}">
    <scroll-view
      id="scroll-3"
      class="pane-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      refresher-enabled
      refresher-background="#f6f4ef"
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onLower"
    >
      <mine-view id="view-mine" bind:switchtab="onViewSwitch" bind:refreshed="onRefreshed"></mine-view>
    </scroll-view>
  </view>

  <tabbar selected="{{tab}}" bind:change="onTabChange" bind:retap="onRetap"></tabbar>
</view>
