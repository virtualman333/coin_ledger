.shell {
  min-height: 100vh;
  background: #f6f4ef;
}

/* 页面本身不再滚动（滚动交给各自的 scroll-view），
   胶囊是 fixed，下拉刷新时不会再被 webview 拖走 */
.pane {
  height: 100vh;
  overflow: hidden;
}

/* scroll-view 默认高度为 0，必须显式撑满视口 */
.pane-scroll {
  height: 100vh;
}

/* 组件节点默认不是块级，双保险：组件内部已有 :host，这里再兜一层，
   避免个别基础库忽略 :host 时视图高度塌掉 */
home-view,
plan-view,
list-view,
mine-view {
  display: block;
}
