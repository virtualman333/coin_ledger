@import "../../styles/ui.wxss";

/* 我的：一条主线从身份到数据再到入口，中间只用细线分隔，不堆卡片 */

.page {
  padding-top: 6rpx;
}

/* ---------- 身份 ---------- */
.me {
  display: flex;
  padding: 4rpx 0 28rpx;
  align-items: center;
  gap: 16rpx;
}

.me-id {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  gap: 20rpx;
}

.me-ava {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  flex: 0 0 auto;
}

.me-ava-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #757575;
  font-size: 34rpx;
  font-weight: 500;
}

.me-txt {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.me-edit {
  padding: 8rpx 22rpx;
  border: 1rpx solid #ededed;
  border-radius: 999rpx;
  color: #151515;
  font-size: 22rpx;
  flex: 0 0 auto;
}

/* ---------- 主数字 ---------- */
.kpi {
  padding: 30rpx 0 26rpx;
}

.kpi-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
  align-items: baseline;
  gap: 6rpx 16rpx;
}

.kpi-d {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 500;
}

/* 涨跌是语义色，不属于装饰色 */
.kpi-d.up { color: #c0392b; }
.kpi-d.down { color: #1e7b4d; }

/* ---------- 空账本 ---------- */
.blank {
  padding: 44rpx 0 46rpx;
}

.blank-t {
  display: block;
  color: #151515;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.blank-btn {
  display: inline-block;
  margin-top: 22rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid #151515;
  border-radius: 10rpx;
  color: #151515;
  font-size: 24rpx;
}

/* ---------- 两格 ---------- */
.duo {
  display: flex;
  padding: 2rpx 0 26rpx;
  gap: 24rpx;
}

.duo-cell {
  flex: 1;
  min-width: 0;
}

.duo-v {
  display: block;
  margin-top: 6rpx;
  color: #151515;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.6rpx;
  line-height: 1.2;
}

/* ---------- 进度 ---------- */
.prog {
  padding: 0 0 30rpx;
}

.prog-top {
  display: flex;
  margin-bottom: 12rpx;
  align-items: baseline;
  justify-content: space-between;
}

.prog-v {
  color: #151515;
  font-size: 22rpx;
  font-weight: 500;
}

/* ---------- 未登录 ---------- */
.guest {
  padding: 64rpx 0 44rpx;
  text-align: center;
}

.guest .u-label {
  display: block;
  margin-top: 10rpx;
}

.guest-btn {
  width: 300rpx;
  margin: 30rpx auto 0;
}

/* ---------- 页脚 ---------- */
.foot {
  margin-top: 22rpx;
  color: #a5a5a5;
  font-size: 20rpx;
  text-align: center;
}
