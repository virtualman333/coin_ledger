/* 我的：一个暖色主视觉块承载全部数字，下面是极简两行。
   不用渐变、不叠阴影，靠留白、字重和一处品牌金建立层次。 */

.page {
  padding-top: 4rpx;
}

/* ---------- 身份 ---------- */
.me {
  display: flex;
  padding: 6rpx 0 26rpx;
  align-items: center;
  gap: 16rpx;
}

.me-id {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  gap: 20rpx;
}

.me-ava {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: #f1eee7;
  flex: 0 0 auto;
}

.me-ava-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a7a5c;
  font-size: 36rpx;
  font-weight: 500;
}

.me-txt {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.me-name {
  color: #1a1714;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.me-sub {
  color: #7a7468;
  font-size: 22rpx;
}

.me-edit {
  padding: 9rpx 22rpx;
  border: 1rpx solid #e8e3d8;
  border-radius: 999rpx;
  color: #6b604c;
  font-size: 22rpx;
  flex: 0 0 auto;
}

/* ---------- 主视觉 ---------- */
.hero {
  padding: 30rpx 32rpx 28rpx;
  border: 1rpx solid #f1ece2;
  border-radius: 26rpx;
  background: #faf8f3;
}

.hero-k {
  display: block;
  color: #7a7468;
  font-size: 22rpx;
}

.hero-line {
  display: flex;
  margin-top: 10rpx;
  align-items: baseline;
  gap: 8rpx;
  flex-wrap: wrap;
}

.hero-cur {
  color: #1a1714;
  font-size: 30rpx;
  font-weight: 500;
}

.hero-v {
  color: #1a1714;
  font-size: 72rpx;
  font-weight: 500;
  line-height: 1.04;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.hero-d {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 500;
}

/* 涨跌是语义色，不是装饰色 */
.hero-d.up { color: #b3402f; }
.hero-d.down { color: #1f7a4d; }

.hero-sub {
  display: block;
  margin-top: 12rpx;
  color: #7a7468;
  font-size: 21rpx;
}

/* 进度做成 20 段刻度，像集章册的格子 */
.hero-prog {
  display: flex;
  margin-top: 22rpx;
  align-items: center;
  gap: 16rpx;
}

.hp-segs {
  flex: 1;
  display: flex;
  gap: 3rpx;
  height: 14rpx;
}

.hp-seg {
  flex: 1;
  border-radius: 2rpx;
  background: rgba(26, 23, 20, 0.09);
}

.hp-seg.on {
  background: #b98f43;
}

.hp-t {
  color: #7a7468;
  font-size: 20rpx;
  flex: 0 0 auto;
}

/* 空状态 / 未登录 */
.hero-empty {
  padding: 44rpx 32rpx 40rpx;
}

.he-t {
  display: block;
  color: #1a1714;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
}

.he-s {
  display: block;
  margin-top: 10rpx;
  color: #7a7468;
  font-size: 23rpx;
}

.he-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #1a1714;
  color: #ffffff;
  font-size: 25rpx;
}

.he-primary {
  width: 300rpx;
  height: 84rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: #1a1714;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 84rpx;
}

.he-primary::after {
  border: none;
}

/* ---------- 两行入口 ---------- */
.rows {
  margin-top: 22rpx;
  border-top: 1rpx solid #f0ece3;
}

.row {
  display: flex;
  min-height: 108rpx;
  align-items: center;
  gap: 14rpx;
  border-bottom: 1rpx solid #f0ece3;
}

.row-hover {
  background: #faf8f3;
}

.row-k {
  flex: 1;
  min-width: 0;
  color: #1a1714;
  font-size: 28rpx;
}

.row-v {
  color: #7a7468;
  font-size: 23rpx;
  flex: 0 0 auto;
}

.row-a {
  color: #b3ab9c;
  font-size: 32rpx;
  line-height: 1;
  flex: 0 0 auto;
}

.row-thumbs {
  display: flex;
  flex: 0 0 auto;
  padding-right: 4rpx;
}

.rt-img {
  width: 54rpx;
  height: 54rpx;
  margin-left: -16rpx;
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
  background: #f1eee7;
}

.rt-img:first-child {
  margin-left: 0;
}

/* ---------- 页脚 ---------- */
.foot {
  margin-top: 22rpx;
  color: #b3ab9c;
  font-size: 20rpx;
  text-align: center;
}
