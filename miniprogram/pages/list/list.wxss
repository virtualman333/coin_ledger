.head {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 16rpx 24rpx 8rpx;
  background: #f6f4ef;
}

.search-row {
  display: flex;
  align-items: center;
}

.search {
  display: flex;
  flex: 1;
  height: 68rpx;
  align-items: center;
  padding: 0 22rpx;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(60, 48, 26, 0.05);
  min-width: 0;
}

.search-icon {
  margin-right: 10rpx;
  color: #c0b9ab;
  font-size: 30rpx;
  line-height: 1;
}

.filter-toggle {
  display: flex;
  height: 68rpx;
  margin-left: 14rpx;
  padding: 0 24rpx;
  align-items: center;
  border: 1rpx solid #e6dfd0;
  border-radius: 34rpx;
  background: #ffffff;
  color: #6b6559;
  font-size: 25rpx;
  flex-shrink: 0;
}

.filter-toggle.on {
  border-color: #d8b978;
  background: #fdf7ea;
  color: #9a6b1f;
  font-weight: 600;
}

.filter-badge {
  margin-left: 8rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #9a6b1f;
  color: #fff;
  font-size: 19rpx;
  line-height: 28rpx;
}

.fpanel {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(60, 48, 26, 0.05);
}

.frow {
  display: flex;
  flex-wrap: wrap;
}

.search-fake {
  display: flex;
  flex: 1;
  height: 68rpx;
  align-items: center;
  min-width: 0;
}

.search-input {
  flex: 1;
  height: 68rpx;
  min-width: 0;
  font-size: 27rpx;
}

.search-ph {
  color: #b9b2a4;
}

.search-clear {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f2efe7;
  color: #a39c8e;
  font-size: 22rpx;
}

.tabs {
  margin-top: 16rpx;
  padding-right: 24rpx;
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  height: 60rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  align-items: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b6559;
  font-size: 24rpx;
}

.tab-on {
  background: #9a6b1f;
  color: #ffffff;
  font-weight: 500;
}

.tab-hover {
  opacity: 0.7;
}

.bar {
  display: flex;
  padding: 16rpx 4rpx 6rpx;
  align-items: center;
  justify-content: space-between;
}

.bar-text {
  color: #8a8378;
  font-size: 22rpx;
}

.bar-actions {
  display: flex;
  align-items: center;
}

.bar-btn {
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b6559;
  font-size: 22rpx;
}

.bar-btn.on {
  background: #f4efe4;
  color: #9a6b1f;
  font-weight: 600;
}

.list {
  padding: 0 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(60, 48, 26, 0.04);
}

.row-hover {
  background: #fbf8f1;
}

.row-main {
  display: flex;
  flex: 1;
  margin-left: 18rpx;
  flex-direction: column;
  min-width: 0;
}

.row-top {
  display: flex;
  align-items: center;
  min-width: 0;
}

.row-name {
  flex: 1;
  overflow: hidden;
  font-size: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-top .tag {
  margin-left: 10rpx;
  flex-shrink: 0;
}

.row-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #8a8378;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-right {
  display: flex;
  margin-left: 16rpx;
  align-items: flex-end;
  flex-direction: column;
  flex-shrink: 0;
}

.row-year {
  color: #a39c8e;
  font-size: 21rpx;
}

.row-price {
  margin-top: 8rpx;
  color: #9a6b1f;
  font-size: 27rpx;
  font-weight: 600;
}

.row-price-k {
  color: #a39c8e;
  font-size: 18rpx;
  font-weight: 400;
}

/* 年份 / 面额 / 材质 筛选条（可横滑） */
.filters{
  display:flex;align-items:center;white-space:nowrap;
  padding:0 24rpx 18rpx;
}
.fbtn{
  display:inline-flex;align-items:center;
  margin-right:14rpx;padding:10rpx 22rpx;border-radius:999rpx;
  font-size:24rpx;color:#7a7a7a;background:#f5f3ee;border:1rpx solid #ece7dc;
}
.fbtn-on{color:#8a6a1f;background:#faf3dd;border-color:#e2cf9a;font-weight:600}
.fbtn-clear{color:#b04a3a;background:#fdf1ef;border-color:#f0d6d1}

/* 第二行：发行量 · 套系 */
.row-sub {
  display: flex;
  margin-top: 6rpx;
  align-items: center;
  overflow: hidden;
  color: #b3aa9b;
  font-size: 20rpx;
  white-space: nowrap;
}

.row-mint {
  color: #9a6b1f;
  font-weight: 500;
}

.row-dot {
  margin: 0 8rpx;
  color: #d6cebe;
}

/* 分类切换：普通纪念币 / 纪念钞 / 贵金属
   之前 .cat-tabs / .cat-tab 没有任何样式，三个 view 直接挤成一行纯文字。 */
.cat-tabs {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0 4rpx;
}

.cat-tab {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e6e0d4;
  background: #ffffff;
  color: #7d766b;
  font-size: 25rpx;
  line-height: 1.4;
  transition: background .15s, color .15s;
}

.cat-tab.on {
  background: #fbf1d8;
  border-color: #d9bd82;
  color: #9a6b1f;
  font-weight: 600;
}

/* ===== 贵金属全量库（金币云集 2823 条）卡片网格 ===== */
.pm-full { padding: 8rpx 24rpx 40rpx; }
.pm-bar { font-size: 24rpx; color: #9a8f7c; margin: 6rpx 0 18rpx; }
.pm-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.pm-card {
  width: calc((100% - 18rpx) / 2);
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #eae2d2;
  border-radius: 18rpx;
  overflow: hidden;
}
.pm-card-hover { opacity: .88; transform: scale(.98); }
.pm-ph {
  width: 100%;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.pm-ph::after {
  content: "";
  position: absolute;
  left: 16%; top: 16%; right: 16%; bottom: 16%;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.55);
  box-shadow: inset 0 0 0 10rpx rgba(255,255,255,.18);
}
.pm-ph text {
  font-size: 64rpx;
  font-weight: 800;
  color: rgba(255,255,255,.92);
  z-index: 1;
}
.pm-gold { background: linear-gradient(145deg, #d4a72c, #b8861b); }
.pm-silver { background: linear-gradient(145deg, #b9c0c8, #9099a3); }
.pm-platinum { background: linear-gradient(145deg, #8d95a0, #6b7480); }
.pm-other { background: linear-gradient(145deg, #c9a227, #a88418); }
.pm-card-b { padding: 14rpx 16rpx 18rpx; }
.pm-card-t {
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #2b2620;
  min-height: 72rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pm-card-m { margin-top: 8rpx; font-size: 21rpx; color: #9a8f7c; }
.pm-card-f { margin-top: 8rpx; font-size: 21rpx; color: #b8861b; }
.pm-card-c { margin-top: 6rpx; font-size: 19rpx; color: #b8ae9c; font-family: monospace; }
.pm-loading, .pm-empty, .pm-end { text-align: center; font-size: 23rpx; color: #9a8f7c; padding: 28rpx 0; }
.pm-more {
  text-align: center;
  font-size: 25rpx;
  color: #a8781f;
  font-weight: 600;
  padding: 22rpx 0;
  margin-top: 16rpx;
  border: 1rpx solid #d9bd82;
  border-radius: 14rpx;
  background: #fbf1d8;
}

/* 贵金属卡片：数据库存的本地缩略图 */
.pm-thumb{width:100%;height:300rpx;display:block;background:#f6f4ef}
