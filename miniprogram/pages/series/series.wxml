<view class="page">
  <view class="head">
    <text class="h1">按系列</text>
    <text class="h-sub">{{total}} 个品种，分成 {{count}} 个系列</text>
  </view>

  <view class="all-card" hover-class="tap-hover" bindtap="goAll">
    <view class="all-main">
      <text class="all-title">全部品种</text>
      <text class="all-sub">{{total}} 个 · 按年份倒序</text>
    </view>
    <text class="all-more">›</text>
  </view>

  <!-- 大品类切换：一次只展示一类 -->
  <view class="cat-tabs">
    <view class="cat-tab {{activeCat === 'coin' ? 'on' : ''}}" data-cat="coin" bindtap="switchCat">
      <text class="ct-label">普通纪念币</text><text class="ct-n">{{coinGroup.length}}</text>
    </view>
    <view class="cat-tab {{activeCat === 'note' ? 'on' : ''}}" data-cat="note" bindtap="switchCat">
      <text class="ct-label">纪念钞</text><text class="ct-n">{{noteGroup.length}}</text>
    </view>
    <view class="cat-tab {{activeCat === 'pm' ? 'on' : ''}}" data-cat="pm" bindtap="switchCat">
      <text class="ct-label">贵金属</text><text class="ct-n">{{pmLoaded ? pmGroup.length : '…'}}</text>
    </view>
  </view>

  <!-- 纪念币 -->
  <view class="sc-group" wx:if="{{activeCat === 'coin' && coinGroup.length}}">
    <view class="sc-group-h coin"><text>普通纪念币</text><text class="sc-g-n">{{coinGroup.length}} 个系列</text></view>
    <view class="cards">
      <view class="scard" wx:for="{{coinGroup}}" wx:key="code" data-code="{{item.code}}" data-cat="coin" bindtap="goSeries" hover-class="tap-hover">
        <image class="scard-img" src="{{item.imgUrl}}" mode="aspectFit" lazy-load wx:if="{{item.imgUrl}}"></image>
        <view class="scard-ph" wx:else><text>{{item.name}}</text></view>
        <view class="scard-body">
          <text class="scard-name">{{item.name}}</text>
          <text class="scard-meta">{{item.count}} 个 · 已藏 {{item.own}}</text>
          <view class="scard-bar"><view class="scard-fill" style="width:{{item.pct}}%"></view></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 普通纪念币空态 -->
  <view class="sc-empty" wx:if="{{activeCat === 'coin' && !coinGroup.length}}">暂无普通纪念币系列</view>

  <!-- 纪念钞 -->
  <view class="sc-group" wx:if="{{activeCat === 'note' && noteGroup.length}}">
    <view class="sc-group-h note"><text>纪念钞</text><text class="sc-g-n">{{noteGroup.length}} 个系列</text></view>
    <view class="cards">
      <view class="scard" wx:for="{{noteGroup}}" wx:key="code" data-code="{{item.code}}" data-cat="note" bindtap="goSeries" hover-class="tap-hover">
        <image class="scard-img" src="{{item.imgUrl}}" mode="aspectFit" lazy-load wx:if="{{item.imgUrl}}"></image>
        <view class="scard-ph" wx:else><text>{{item.name}}</text></view>
        <view class="scard-body">
          <text class="scard-name">{{item.name}}</text>
          <text class="scard-meta">{{item.count}} 个 · 已藏 {{item.own}}</text>
          <view class="scard-bar"><view class="scard-fill" style="width:{{item.pct}}%"></view></view>
        </view>
      </view>
    </view>
  </view>

  <view class="sc-empty" wx:if="{{activeCat === 'note' && !noteGroup.length}}">暂无纪念钞系列</view>

  <!-- 贵金属 -->
  <view class="sc-group" wx:if="{{activeCat === 'pm'}}">
    <view class="sc-group-h pm"><text>贵金属纪念币</text><text class="sc-g-n">{{pmLoaded ? pmGroup.length + ' 个项目' : '加载中…'}}</text></view>
    <view class="cards" wx:if="{{pmLoaded && pmGroup.length}}">
      <view class="scard scard-pm" wx:for="{{pmGroup}}" wx:key="code" data-code="{{item.code}}" data-cat="pm" bindtap="goSeries" hover-class="tap-hover">
        <view class="scard-media">
          <image class="scard-img" wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFit" lazy-load></image>
          <view class="scard-ph" wx:else><text>贵金属</text></view>
          <text class="scard-badge">{{item.count}} 枚</text>
        </view>
        <view class="scard-body">
          <text class="scard-name">{{item.name}}</text>
          <view class="scard-tags" wx:if="{{item.yearText || item.matText}}">
            <text class="scard-tag" wx:if="{{item.yearText}}">{{item.yearText}}</text>
            <text class="scard-tag" wx:if="{{item.matText}}">{{item.matText}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="sc-empty" wx:elif="{{pmLoaded}}">暂无贵金属项目</view>
    <view class="sc-empty" wx:else>正在加载贵金属项目…</view>
  </view>
</view>
