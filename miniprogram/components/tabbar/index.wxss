@import "./icons.wxss";

/* =========================================================
   底部 TabBar · 鸿蒙风悬浮玻璃胶囊
   - 玻璃：上沿略实、中段最透、下沿收一点的纵向渐变 + 高斯模糊
   - 立体：双层落影撑高度，内层高光/反光做厚度，顶部斜向反光面模拟受光
   - 选中：淡金药丸（自带投影 + 内侧白边），浮在玻璃上而不是贴在上面
   - 触摸：按下 0.08s 压扁变淡，松手 0.16s ease-out 回位（不要过冲曲线）
   ========================================================= */

.tabbar {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 116rpx;
  padding: 10rpx;
  border-radius: 999rpx;
  /* 白度按 iOS 磨砂玻璃的量级（约 0.7）：再透就会出事 ——
     首页底部的「今日金银价」是深色卡片，胶囊压上去时未选中的灰字会看不清。
     透感交给高斯模糊和大面积高光，不靠压低白度。 */
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.8) 0%,
    rgba(255, 255, 255, 0.68) 58%,
    rgba(255, 255, 255, 0.76) 100%
  );
  /* blur 用 px 而不是 rpx：部分基础库对 filter 里的 rpx 转换不完整 */
  -webkit-backdrop-filter: blur(14px) saturate(170%);
  backdrop-filter: blur(14px) saturate(170%);
  /* 强制独立合成层：否则滚动时 backdrop-filter 重算，底面会闪白 */
  transform: translateZ(0);
  will-change: transform;
  box-shadow:
    /* 落影：透得狠，投影就要更实，否则胶囊边界糊在背景里 */
    0 22rpx 48rpx rgba(60, 48, 26, 0.22),
    0 6rpx 14rpx rgba(60, 48, 26, 0.08),
    /* 玻璃厚度：顶部亮边 + 底部反光 + 外圈描边 */
    inset 0 1rpx 0 rgba(255, 255, 255, 1),
    inset 0 -2rpx 6rpx rgba(120, 100, 70, 0.05),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.9);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 受光面：左上斜向一道 + 上沿薄薄一层，压太重会变成白雾盖住透感 */
.tb-gloss {
  position: absolute;
  top: 1rpx;
  right: 1rpx;
  bottom: 1rpx;
  left: 1rpx;
  z-index: 0;
  border-radius: 999rpx;
  background:
    linear-gradient(
      104deg,
      rgba(255, 255, 255, 0.32) 0%,
      rgba(255, 255, 255, 0.06) 16%,
      rgba(255, 255, 255, 0) 30%
    ),
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.36) 0%,
      rgba(255, 255, 255, 0.04) 12%,
      rgba(255, 255, 255, 0) 26%
    );
  pointer-events: none;
}

/* 药丸滑片：宽度恒为 1/4，translateX 位移由 selected 驱动。
   自带投影 + 内侧白边，看起来是嵌在玻璃里的一枚实体小金片 */
.tb-pill {
  position: absolute;
  top: 10rpx;
  right: auto;
  bottom: 10rpx;
  left: 10rpx;
  z-index: 0;
  width: calc((100% - 20rpx) / 4);
  border-radius: 999rpx;
  background: linear-gradient(
    180deg,
    #fdf4de 0%,
    #f8e8c6 52%,
    #f3debb 100%
  );
  box-shadow:
    0 4rpx 10rpx rgba(154, 107, 31, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 1),
    inset 0 -3rpx 5rpx rgba(186, 144, 66, 0.16),
    inset 0 0 0 1rpx rgba(212, 174, 104, 0.26);
  /* 组件常驻，过渡一直挂着；切视图不会重建它，滑动天然连续 */
  transition: transform 0.26s cubic-bezier(0.3, 0.88, 0.3, 1);
  will-change: transform;
}

.tb-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  border-radius: 999rpx;
}

.tb-ico {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 auto;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  /* 松手回位用短 ease-out：过冲曲线会先弹过头再缩回来，像动画播了两次 */
  transition: transform 0.16s ease-out;
}

.tb-txt {
  flex: 0 0 auto;
  color: #6b6559;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  /* 玻璃是透的，文字可能压在彩色内容上，加一层白色光晕把字托出来 */
  text-shadow: 0 0 3rpx rgba(255, 255, 255, 0.95), 0 1rpx 2rpx rgba(255, 255, 255, 0.85);
  transition: color 0.2s ease, opacity 0.16s ease, transform 0.16s ease-out;
}

/* 选中：图标微放大 + 极轻浮雕，文字转品牌金加粗 */
.tb-item.on .tb-ico {
  transform: scale(1.04);
  -webkit-filter: drop-shadow(0 1rpx 1rpx rgba(154, 107, 31, 0.18));
  filter: drop-shadow(0 1rpx 1rpx rgba(154, 107, 31, 0.18));
}

.tb-item.on .tb-txt {
  color: #8f5f14;
  font-weight: 600;
}

/* ---- 触摸反馈 ----
   按下快速压扁变淡，优先于 .tb-item.on 的 scale，所以带 .tabbar 前缀 */
.tabbar .tb-item-press .tb-ico {
  transform: scale(0.88);
  transition: transform 0.08s ease-out;
}

.tabbar .tb-item-press .tb-txt {
  opacity: 0.55;
  transform: scale(0.94);
  transition: opacity 0.08s ease-out, transform 0.08s ease-out;
}
