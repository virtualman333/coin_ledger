@import "./icons.wxss";

/* =========================================================
   自定义 tabBar · 鸿蒙风悬浮玻璃胶囊
   - 玻璃：72% 白 + 高斯模糊 + 饱和提升，底下内容隐约透出
   - 立体：外层双层落影撑起高度，内层高光/反光做出玻璃厚度，
           顶部一整片渐变反光面（.tb-gloss）模拟受光
   - 选中：淡金药丸带自身投影，浮在玻璃上而不是贴在上面
   - 触摸：按下 0.1s 快速下沉（图标压扁 + 文字变淡），
           松手 0.34s 弹性回弹；另配一次轻振动
   ========================================================= */

.tabbar {
  position: fixed;
  left: 26rpx;
  right: 26rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 108rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  /* 透一点底，玻璃才有"透"的感觉 */
  background-color: rgba(255, 255, 255, 0.62);
  /* 不支持 backdrop-filter 的机型退化为半透白底，仍能压住内容。
     blur 用 px 而不是 rpx：部分基础库对 filter 里的 rpx 转换不完整 */
  -webkit-backdrop-filter: blur(20px) saturate(200%);
  backdrop-filter: blur(20px) saturate(200%);
  box-shadow:
    /* 落影：大而淡，撑起悬浮高度 */
    0 18rpx 40rpx rgba(60, 48, 26, 0.16),
    0 4rpx 12rpx rgba(60, 48, 26, 0.08),
    /* 玻璃厚度：顶部亮边 + 底部反光 + 外圈描边 */
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98),
    inset 0 -2rpx 6rpx rgba(120, 100, 70, 0.06),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.72);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 受光面：上半部渐亮，做出玻璃的弧面反光 */
.tb-gloss {
  position: absolute;
  top: 1rpx;
  right: 1rpx;
  bottom: 1rpx;
  left: 1rpx;
  z-index: 0;
  border-radius: 999rpx;
  background:
    /* 左上斜向反光：只在边角出一道亮，别铺满整块，否则玻璃又变回实心白 */
    linear-gradient(
      104deg,
      rgba(255, 255, 255, 0.42) 0%,
      rgba(255, 255, 255, 0.08) 18%,
      rgba(255, 255, 255, 0) 34%
    ),
    /* 上沿受光：薄薄一层，落在胶囊边框附近 */
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.5) 0%,
      rgba(255, 255, 255, 0.06) 16%,
      rgba(255, 255, 255, 0) 34%
    );
  pointer-events: none;
}

/* 药丸滑片：宽度恒为 1/4，translateX 位移由 selected 驱动。
   自带投影 + 顶部内高光，看起来是浮在玻璃上的一枚小金片 */
.tb-pill {
  position: absolute;
  top: 8rpx;
  right: auto;
  bottom: 8rpx;
  left: 8rpx;
  z-index: 0;
  width: calc((100% - 16rpx) / 4);
  border-radius: 999rpx;
  background: linear-gradient(180deg, #fdf6e7 0%, #f5e7c9 100%);
  box-shadow:
    0 4rpx 10rpx rgba(154, 107, 31, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -3rpx 5rpx rgba(199, 160, 88, 0.14),
    inset 0 0 0 1rpx rgba(214, 178, 110, 0.22);
  transition: transform 0.42s cubic-bezier(0.3, 0.9, 0.3, 1);
  will-change: transform;
}

.tb-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border-radius: 999rpx;
}

.tb-ico {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 auto;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  /* 松手：带一点过冲的弹性回位 */
  transition: transform 0.34s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tb-txt {
  flex: 0 0 auto;
  color: #8f8878;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  transition: color 0.24s ease, opacity 0.2s ease,
    transform 0.34s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 选中：图标微放大并带一点浮雕投影，文字转品牌金加粗 */
.tb-item.on .tb-ico {
  transform: scale(1.06);
  -webkit-filter: drop-shadow(0 1rpx 1rpx rgba(154, 107, 31, 0.22));
  filter: drop-shadow(0 1rpx 1rpx rgba(154, 107, 31, 0.22));
}

.tb-item.on .tb-txt {
  color: #9a6b1f;
  font-weight: 600;
}

/* ---- 触摸反馈 ----
   按下：0.1s 快速压扁下沉，比松手的弹性快得多，手感才跟手。
   优先级要压过 .tb-item.on .tb-ico 的 scale(1.06)，所以带 .tabbar 前缀。 */
.tabbar .tb-item-press .tb-ico {
  transform: scale(0.8) translateY(2rpx);
  transition: transform 0.1s ease-out;
}

.tabbar .tb-item-press .tb-txt {
  opacity: 0.5;
  transform: scale(0.92);
  transition: opacity 0.1s ease-out, transform 0.1s ease-out;
}
