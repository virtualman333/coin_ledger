<!-- 自定义 tabBar：鸿蒙风悬浮玻璃胶囊。
     动画只给"点击切换"用（anim）：页面切过来时首帧直接定格在目标格，
     否则新实例会从第 1 格滑到目标格，看着像又播了一遍动画。 -->
<view class="tabbar" aria-role="tablist">
  <!-- 玻璃顶部高光（3D 反光面），必须在最底层 -->
  <view class="tb-gloss"></view>
  <!-- 选中态滑片：宽度固定为 1/4，靠 translateX 位移，弹性跟随 -->
  <view
    class="tb-pill"
    style="transform: translateX({{selected * 100}}%);{{anim ? 'transition:transform .26s cubic-bezier(.3,.88,.3,1);' : 'transition:none;'}}"
  ></view>

  <view
    class="tb-item {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
    hover-class="tb-item-press"
    hover-start-time="0"
    hover-stay-time="90"
    aria-role="tab"
    aria-selected="{{selected === index}}"
    aria-label="{{item.text}}"
  >
    <view class="tb-ico ico-{{item.icon}}"></view>
    <text class="tb-txt">{{item.text}}</text>
  </view>
</view>
