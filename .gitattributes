# 服务器上执行的脚本必须是 LF，否则 set -euo pipefail 会因 \r 报错
*.sh      text eol=lf
*.py      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.txt     text eol=lf

# 二进制资源不做任何换行符/编码转换
*.jpg    binary
*.jpeg   binary
*.png    binary
*.ico    binary
*.webp   binary
*.woff2  binary
*.gz     binary

# 前端产物按体积统计时对 diff 无用，但保留文本属性便于查看
*.svg text
